# @fitvo/worker — variaveis de ambiente (placeholders). Copie para apps/worker/.env.
NODE_ENV=development
LOG_LEVEL=info
REDIS_URL=redis://localhost:6379

# Banco (local: docker/docker-compose.yml). Role de runtime fitvo_app (D-155,
# ADR-0017 Slice 3/3), SEM BYPASSRLS/SUPERUSER -- ver docs/troubleshooting.md.
DATABASE_URL=postgresql://fitvo_app:change-me@localhost:5434/fitvo?schema=public
# Role administrativo estreito (ADR-0017 D-152/D-155): usado pela regua de
# cobranca (PrismaCollectionRulerRepository) -- varre TODAS as subscriptions
# nao-terminais sem filtro de tenant, mesmo formato do gap do webhook Asaas.
WEBHOOK_DATABASE_URL=postgresql://fitvo_webhook:change-me@localhost:5434/fitvo?schema=public
