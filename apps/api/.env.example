# @fitvo/api — variaveis de ambiente (placeholders). Copie para apps/api/.env.
NODE_ENV=development
LOG_LEVEL=info
PORT=3333
HOST=0.0.0.0
CORS_ORIGIN=*

# Banco e cache (local: docker/docker-compose.yml)
DATABASE_URL=postgresql://fitvo:change-me@localhost:5432/fitvo?schema=public
REDIS_URL=redis://localhost:6379

# Auth (JWT) — gerar segredos fortes por ambiente; min. 16 chars
JWT_ACCESS_SECRET=change-me-access-secret-min-16
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_ISSUER=fitvo-api

# Convite admin->profissional — validade em segundos (default 7 dias, D-055)
PROFESSIONAL_INVITE_TTL_SECONDS=604800
# Convite profissional->paciente — validade em segundos (default 7 dias, D-055)
PATIENT_INVITE_TTL_SECONDS=604800

# Financeiro / Asaas (ADR-0004) — LIVE GATED. Todas OPCIONAIS: sem elas a API
# sobe e usa o FakePaymentGateway deterministico. NUNCA colocar segredos reais
# aqui nem no repo (publico) — apenas placeholders. Rotacionar se vazar.
ASAAS_API_KEY=change-me-asaas-api-key
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_WEBHOOK_SECRET=change-me-asaas-webhook-secret
ASAAS_PLATFORM_WALLET_ID=change-me-fitvo-wallet-id
