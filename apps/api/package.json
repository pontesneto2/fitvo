    "@fastify/swagger-ui": "^6.1.0",
    "@fitvo/auth": "workspace:*",
    "@fitvo/config": "workspace:*",
    "@fitvo/database": "workspace:*",
    "@fitvo/observability": "workspace:*",
    "@fitvo/payments": "workspace:*",
    "@fitvo/queue": "workspace:*",
    "@fitvo/validation": "workspace:*",
    "fastify": "^5.5.0",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^5.11.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fitvo/eslint-config": "workspace:*",
    "@fitvo/typescript-config": "workspace:*",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "tsx": "^4.23.5",
    "typescript": "^5.6.2",
    "vitest": "^4.1.10"
