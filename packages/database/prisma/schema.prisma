// FITVO — Prisma schema.
// Fase 1: apenas datasource + generator. NENHUM model de negocio ainda.
// As entidades (account, tenant, bond, consent, billing...) entram na Fase 2.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
