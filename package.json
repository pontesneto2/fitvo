{
  "name": "fitvo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "FITVO — SaaS multi-especialidade de saude e fitness (monorepo).",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,yml,yaml}\"",
    "lint:root": "eslint .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@fitvo/eslint-config": "workspace:*",
    "eslint": "^10.7.0",
    "husky": "^9.1.6",
    "lint-staged": "^17.1.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ],
    "overrides": {
      "ioredis": "^5.11.1",
      "postcss": "^8.5.10"
    }
  }
}
