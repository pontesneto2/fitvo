// FITVO — Prisma schema.
// Fase 2 (fatia 1): identidade + tenancy. Sem vinculo/consentimento/financeiro
// ainda (fases seguintes). Datas em UTC (D-067); dinheiro nao aparece aqui.
//
// Fundamentos (ADRs):
// - Account (identidade) separada dos perfis de papel; 1 conta = N papeis
//   (D-041/D-044). Login por e-mail unico (D-042). Documento fiscal (D-043).
// - Tenant = clinica ou profissional solo (tenant de 1) (D-012/D-045).
// - Profissional tem N especialidades, cada uma verificada pela plataforma
//   (D-008/D-046). Especialidades = catalogo fixo (D-047).
// - RBAC 4 niveis; admin de clinica desacoplado de profissional (D-013/D-015).

/// OUTPUT EXPLICITO, DENTRO DO PACOTE — nao e preferencia, e correcao de CI.
///
/// O default do Prisma escreve em `node_modules/.pnpm/@prisma+client@.../
/// node_modules/.prisma/client`: o virtual store COMPARTILHADO do pnpm, FORA
/// deste pacote. O turbo so captura o que esta DENTRO do pacote, entao o
/// artefato ficava invisivel para ele: `build` reportava `cache HIT` e
/// restaurava ZERO arquivos. Verde que mente em forma de cache.
///
/// A defesa contra esse cache mentiroso CRIOU uma corrida: como ninguem podia
/// confiar que o `build` produzira algo, enxertou-se `prisma generate` tambem no
/// `typecheck` e no `test:integration` — e `database#build` e `database#typecheck`
/// nao dependem um do outro, entao o turbo os rodava EM PARALELO, dois `generate`
/// escrevendo no mesmo diretorio. Um truncava enquanto o outro lia. Mesmo codigo,
/// CI vermelho aleatoriamente.
///
/// Com o output aqui: o turbo cacheia de verdade (ver packages/database/turbo.json),
/// so o `build` gera, e os demais dependem dele. Ver docs/troubleshooting.md §13.
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum TenantType {
  SOLO // profissional solo: tenant de 1 pessoa (auto-criado)
  CLINIC // clinica: tenant multiprofissional
  /// Academia (D-141): MESMO cadastro de empresa da clinica (spec §4.2/§4.3) —
  /// CNPJ obrigatorio, admin gestor/gestor-que-atende. Difere na VERTICAL: so
  /// profissoes de CREF (Educador Fisico / Personal Trainer) e e o unico tenant
  /// que hospeda o seat de estagiario (InternProfile — D-142).
  ACADEMIA
}

enum DocumentType {
  CPF
  CNPJ
}

/// Unidade federativa brasileira (27: 26 estados + DF). Enum, nao String: o
/// conselho profissional e ESTADUAL e a UF vai impressa em documento (receita —
/// D-126) — estado invalido deve ser irrepresentavel, mesma disciplina de
/// Weekday/SetTechnique. Reusado por ProfessionalSpecialty.councilState (UF do
/// conselho) e Tenant.addressState (UF da clinica).
enum BrazilianState {
  AC
  AL
  AM
  AP
  BA
  CE
  DF
  ES
  GO
  MA
  MG
  MS
  MT
  PA
  PB
  PE
  PI
  PR
  RJ
  RN
  RO
  RR
  RS
  SC
  SE
  SP
  TO
}

/// Sexo biologico — dado clinico que e a base das faixas de referencia
/// laboratoriais (D-124 — ADR-0014: fisiologia hormonal/hematologica difere por
/// sexo). Vive no Account (com nome e CPF) porque e atributo da PESSOA, nao do
/// papel (D-044) — a mesma conta acumula profissional e paciente. NAO e
/// identidade de genero: nao usar para tratamento nem nome social (se um dia for
/// preciso, e campo separado). Faixa so e derivavel para MALE/FEMALE; para
/// INTERSEX e NOT_INFORMED o sistema NAO adivinha — exibe o valor SEM faixa e o
/// profissional interpreta (regra fixada no D-124, ADR-0014).
enum BiologicalSex {
  MALE
  FEMALE
  INTERSEX
  NOT_INFORMED
}

/// Genero / identidade (spec §3.1 — dado sensivel LGPD). Inclusivo e OPCIONAL em
/// todos os cadastros. Distinto de BiologicalSex de proposito: identidade
/// (respeito) vs. sexo biologico (calculo clinico) resolvem problemas
/// diferentes — um campo so forcaria escolher entre acertar o calculo e
/// respeitar a pessoa. Nulavel: null = "nao informado" (campo opcional).
enum Gender {
  MULHER_CIS
  HOMEM_CIS
  MULHER_TRANS
  HOMEM_TRANS
  NAO_BINARIO
  OUTRO
  PREFIRO_NAO_INFORMAR
}

enum SpecialtyCode {
  TRAINING // treino / educacao fisica (CREF)
  NUTRITION // nutricao (CRN)
  MEDICINE // medicina (CRM)
  PERSONAL_TRAINER // personal trainer (CREF) — sem RQE, conselho igual a TRAINING
}

/// Especialidade MEDICA (D-137 — ADR-0015). Escopo DELIBERADAMENTE minimo: so as
/// duas especialidades medicas que o produto atende hoje. NAO se confunde com
/// `rqe` (registro generico do CRM) — e uma qualificacao propria, em coluna
/// propria de ProfessionalSpecialty. So faz sentido quando a especialidade e
/// MEDICINE; a regra "so quando MEDICINE" e da aplicacao/Zod, nao da coluna.
enum MedicalSpecialty {
  NUTROLOGIA
  ENDOCRINOLOGIA
}

enum VerificationStatus {
  PENDING // cadastrado, aguardando envio/analise
  IN_ANALYSIS // documentos em revisao pela plataforma
  VERIFIED // habilitado a atender naquela especialidade
  REJECTED
}

enum ClinicRole {
  CLINIC_ADMIN // admin de clinica (visao ampla, dado operacional; nunca clinico)
}

/// Area de estagio (D-143). O estagiario NAO tem conselho proprio (e estudante,
/// em qualquer area) — declara a AREA em que estuda, e a area determina QUAL
/// conselho o responsavel precisa ter:
///   EDUCACAO_FISICA -> CREF (TRAINING/PERSONAL_TRAINER)
///   NUTRICAO        -> CRN  (NUTRITION)
///   MEDICINA        -> CRM  (MEDICINE)
/// O mapa vive no contrato (@fitvo/validation, SUPERVISOR_SPECIALTY_CODES_BY_AREA):
/// servidor e UI precisam concordar sobre quem pode supervisionar o que.
/// NAO se confunde com SpecialtyCode: aquele e a profissao de quem JA tem
/// registro; esta e a area de quem ainda ESTUDA.
enum InternArea {
  EDUCACAO_FISICA
  NUTRICAO
  MEDICINA
}

enum InviteStatus {
  PENDING // aguardando aceite do profissional
  ACCEPTED // aceito: profissional vinculado a clinica
  EXPIRED // expirado (expiresAt no passado) sem aceite
  REVOKED // revogado pelo admin antes do aceite
}

/// Estado do vinculo paciente<->profissional (D-052/D-053). Encerrar um vinculo
/// nao apaga dados: vira ARQUIVO e o historico e preservado (D-053).
enum BondStatus {
  ACTIVE // vinculo aberto: o "ambiente" da especialidade esta habilitado
  ARCHIVED // encerrado: dados preservados, paciente segue vendo o historico
}

/// Estado da autorizacao de compartilhamento do paciente (D-016/ADR-0003). O
/// paciente concede (ACTIVE) e revoga (REVOKED) granularmente. Default minimo:
/// so dois estados — o "grant" e sempre um ato explicito do paciente.
enum ConsentStatus {
  ACTIVE // autorizacao vigente
  REVOKED // revogada pelo paciente (revokedAt preenchido)
}

/// Estado de uma sugestao de compartilhamento emitida pelo motor (D-017). A
/// sugestao NAO compartilha nada por si — ela apenas convida o paciente a
/// autorizar. PENDING ao ser criada; DISMISSED se o paciente ignora; ACTED se
/// leva a um consentimento. (Transicoes DISMISSED/ACTED ficam para a fase de
/// notificacoes — D-028; aqui o motor so cria PENDING.)
enum SuggestionStatus {
  PENDING
  DISMISSED
  ACTED
}

/// Documento legal rastreado para aceite (D-025 — LGPD). Extensivel de
/// proposito (ADR-0002 gate de reconsentimento); hoje cobre so os dois
/// documentos obrigatorios no cadastro. NAO confundir com o `Consent` acima:
/// aquele e compartilhamento clinico entre profissionais (ADR-0003/D-016),
/// este e aceite de Termos de Uso/Politica de Privacidade — conceitos legais
/// distintos, por isso nomes distintos (Terms* vs Consent*).
enum TermsDocumentSlug {
  TERMS_OF_USE
  PRIVACY_POLICY
}

/// Tipo de evento imutavel de aceite/revogacao de termos (D-025).
enum TermsAcceptanceEventType {
  ACCEPTED
  REVOKED
}

// ---------------------------------------------------------------------------
// Identidade
// ---------------------------------------------------------------------------

/// Conta = identidade unica de login. Acumula N papeis (profissional, paciente,
/// admin de clinica, super admin) sob a mesma conta (D-041/D-044).
model Account {
  id                String          @id @default(cuid())
  email             String          @unique
  passwordHash      String
  name              String
  document          String // CPF ou CNPJ da PESSOA (D-043)
  documentType      DocumentType
  /// Nome social (Decreto 8.727/2016 — spec §3.1). Atributo da PESSOA (D-044).
  /// Quando preenchido, e o nome EXIBIDO no lugar do civil em toda a interface
  /// (derivacao displayName no servidor). Nulavel: opcional; null = sem nome
  /// social. O `name` civil segue para tenant.name/documento/fiscal.
  socialName        String?
  /// Genero / identidade (ver enum Gender). Nulavel: opcional (spec §3.1).
  gender            Gender?
  /// Data de nascimento (D-044: atributo da PESSOA, nao do papel — a mesma conta
  /// acumula profissional + paciente, entao mora aqui com nome e CPF, nao no
  /// perfil). Idade e DERIVADA, nunca armazenada (mesma disciplina do IMC — D-132).
  /// @db.Date: e data de CALENDARIO, nao instante — timestamptz reintroduziria o
  /// deslize de fuso do ADR-0012 (ninguem nasce "as 00h UTC"). Nulavel: conta
  /// antiga nao tem, e null e a unica representacao de "desconhecido".
  birthDate         DateTime?       @db.Date
  /// Sexo biologico (ver enum BiologicalSex). NOT NULL com default: NOT_INFORMED
  /// JA E o estado "desconhecido", entao nulavel criaria DUAS representacoes do
  /// mesmo estado (null e NOT_INFORMED) — o anti-padrao que o projeto evita (D-103).
  biologicalSex     BiologicalSex   @default(NOT_INFORMED)
  /// WhatsApp da PESSOA — SO digitos (11: DDD + celular). Atributo da pessoa
  /// (D-044), como nome/CPF/nascimento. Nulavel: coluna aditiva e conta antiga
  /// nao tem. A obrigatoriedade no cadastro e da app/Zod, nao do banco.
  whatsapp          String?
  /// Endereco da PESSOA (D-044) — colunas inline, espelhando o precedente do
  /// Tenant (addressStreet..addressZipCode). addressNumber/addressZipCode sao
  /// String, nao Int: "123-A"/"s/n" e o CEP com zero a esquerda nao sao numeros.
  /// Todas nulaveis: migracao aditiva + conta antiga sem endereco; a
  /// obrigatoriedade no cadastro do autonomo e imposta pelo Zod (ADR-0015).
  addressStreet     String?
  addressNumber     String?
  addressComplement String?
  addressDistrict   String?
  addressCity       String?
  addressState      BrazilianState?
  addressZipCode    String?
  addressCountry    String?
  emailVerifiedAt   DateTime?       @db.Timestamptz(3)
  preferredLocale   String          @default("pt-BR") // i18n (D-066)
  preferredTimezone String          @default("America/Sao_Paulo") // exibicao (D-067)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)

  professionalProfile   ProfessionalProfile?
  internProfile         InternProfile? // seat de estagiario supervisionado (D-142)
  receptionProfile      ReceptionProfile? // seat administrativo de recepcao (D-156)
  patientProfile        PatientProfile?
  platformAdmin         PlatformAdmin?
  clinicMemberships     ClinicMembership[]
  notifications         Notification[] // central in-app / sininho (D-097/D-028)
  attendancesOpened     Attendance[] // atendimentos abertos por esta conta (D-096)
  attendanceMessages    AttendanceMessage[] // mensagens enviadas por esta conta (D-096)
  termsAcceptanceEvents TermsAcceptanceEvent[] // aceite/revogacao de termos (D-025); onDelete Restrict — nunca perde prova

  // Autoria de secoes da anamnese (D-102 — ADR-0011). onDelete Restrict nas
  // secoes: apagar a conta nao pode apagar a autoria de um documento clinico.
  anamnesisParqAuthored             AnamnesisParq[]
  anamnesisGoalAuthored             AnamnesisGoal[]
  anamnesisClinicalHistoryAuthored  AnamnesisClinicalHistory[]
  anamnesisFamilyHistoryAuthored    AnamnesisFamilyHistory[]
  anamnesisLifestyleAuthored        AnamnesisLifestyle[]
  anamnesisEmergencyContactAuthored AnamnesisEmergencyContact[]
  anamnesisTrainingAuthored         AnamnesisTraining[]

  @@map("account")
}

/// Super Admin FITVO (gestao da plataforma inteira — D-013).
model PlatformAdmin {
  id        String   @id @default(cuid())
  accountId String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("platform_admin")
}

// ---------------------------------------------------------------------------
// Tenancy (clinica / solo)
// ---------------------------------------------------------------------------

/// Unidade de isolamento de dados e cobranca. Solo = tenant de 1 (auto-criado);
/// clinica = tenant multiprofissional com admin (D-012/D-045).
model Tenant {
  id           String        @id @default(cuid())
  type         TenantType
  name         String // nome de EXIBICAO: SOLO herda o nome da pessoa; CLINIC/ACADEMIA = nome fantasia
  /// Razao social (dado formal/fiscal) da empresa — CLINIC/ACADEMIA. Nulavel: o
  /// SOLO nao tem razao social (a exibicao ja vive em `name`); coluna aditiva
  /// (spec §4.2). `name` = nome fantasia (exibicao), `legalName` = razao social.
  legalName    String?
  document     String? // CNPJ da CLINICA mora aqui (D-043); solo herda o da conta
  documentType DocumentType?

  /// Endereco e contato da clinica — cabecalho IMPRESSO da receita/declaracao
  /// (D-126/D-130). Estrutura moderada, de proposito: TISS-level fica fora (D-121).
  /// addressNumber e addressZipCode sao String, nao Int: "123-A"/"s/n" e o CEP com
  /// zero a esquerda nao sao numeros. Todos nulaveis — solo pode nao ter endereco.
  addressStreet     String?
  addressNumber     String?
  addressComplement String?
  addressDistrict   String?
  addressCity       String?
  addressState      BrazilianState?
  addressZipCode    String?
  phone             String?
  email             String?
  /// Logo da clinica. UMA coluna, DOIS consumidores: cabecalho da receita (D-126)
  /// e white-label estrutural (D-078 — ADR-0008) — o MESMO ativo, nao dois campos
  /// competindo. Referencia S3 (sem binario aqui), padrao de ProgressPhoto.storageKey.
  logoStorageKey    String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  professionals    ProfessionalProfile[]
  interns          InternProfile[] // seats de estagiario da academia (D-142)
  receptionists    ReceptionProfile[] // seats administrativos de recepcao (D-156)
  memberships      ClinicMembership[]
  invites          ProfessionalInvite[]
  internInvites    InternInvite[]
  receptionInvites ReceptionInvite[]
  patientInvites   PatientInvite[]
  bonds            Bond[]
  paymentAccount   PaymentAccount? // subconta Asaas + taxa por tenant (ADR-0004/D-058)
  subscriptions    Subscription[] // assinaturas de plano da plataforma (Fluxo A)
  charges          Charge[] // cobrancas paciente->profissional (Fluxo B, via split)
  workoutPlans     WorkoutPlan[] // planos de treino escopados ao tenant (ADR-0009)
  workouts         Workout[] // conteudo de treino escopado ao tenant (ADR-0006)
  workoutItems     WorkoutItem[] // itens prescritos escopados ao tenant (D-166 — ADR-0009)
  workoutSets      WorkoutSet[] // series prescritas escopadas ao tenant (D-166 — ADR-0009)
  workoutSessions  WorkoutSession[] // execucoes escopadas ao tenant (ADR-0009)
  setLogs          SetLog[] // series executadas escopadas ao tenant (D-166 — ADR-0009)
  workoutRatings   WorkoutRating[] // avaliacoes de treino escopadas ao tenant (D-166 — ADR-0009)
  exercises        Exercise[] // biblioteca do tenant; PLATFORM tem tenantId NULL (D-166/D-089)
  formAnalyses     FormAnalysis[] // analises de forma escopadas ao tenant (ADR-0009)
  mealPlans        MealPlan[] // conteudo de nutricao escopado ao tenant (ADR-0006)
  mealLogs         MealLog[] // registros de refeicao escopados ao tenant (D-118 — ADR-0013)
  encounters       Encounter[] // atendimentos escopados ao tenant (ADR-0006)
  medicalRecords   MedicalRecord[] // prontuarios escopados ao tenant (ADR-0006)
  prescriptions    Prescription[] // folhas de receita escopadas ao tenant (ADR-0006)
  anamneses        Anamnesis[] // anamneses escopadas ao tenant (ADR-0010)
  assessments      Assessment[] // avaliacao/medidas escopadas ao tenant (ADR-0006)
  progressPhotos   ProgressPhoto[] // fotos de evolucao escopadas ao tenant (ADR-0006)
  attendances      Attendance[] // atendimentos (ticket) escopados ao tenant (ADR-0010)
  appointments     Appointment[] // agendamentos escopados ao tenant (ADR-0012)

  @@map("tenant")
}

/// Vinculo de uma pessoa a uma clinica como ADMIN (papel desacoplado de
/// profissional — D-013/D-015). Admin puro nunca acessa dado clinico.
model ClinicMembership {
  id        String     @id @default(cuid())
  accountId String
  tenantId  String
  role      ClinicRole @default(CLINIC_ADMIN)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([accountId, tenantId])
  @@index([tenantId])
  @@map("clinic_membership")
}

// ---------------------------------------------------------------------------
// Perfis de papel: profissional e paciente
// ---------------------------------------------------------------------------

/// Perfil profissional (1:1 com a conta). Pertence a um tenant: o proprio
/// (solo) ou a clinica que o convidou (D-045/D-048).
model ProfessionalProfile {
  id          String   @id @default(cuid())
  accountId   String   @unique
  tenantId    String
  displayName String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  account                 Account                     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tenant                  Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  specialties             ProfessionalSpecialty[]
  /// Estagiarios sob supervisao deste profissional (D-142). A capacidade deles
  /// DERIVA do conselho ativo daqui — ver a nota de derivacao em InternProfile.
  /// TODO(treino): o FLUXO DE VALIDACAO do trabalho do estagiario
  /// (produz -> pendente -> supervisor revisa/ajusta/valida -> chega ao aluno)
  /// engancha NESTA relacao quando o dominio de treino/prescricao existir.
  /// Ver docs/roadmap.md. Este slice cria so identidade + vinculo.
  supervisedInterns       InternProfile[]             @relation("InternSupervisor")
  supervisedInternInvites InternInvite[]              @relation("InternInviteSupervisor")
  patientInvites          PatientInvite[]
  bonds                   Bond[]
  consentsReceived        Consent[] // consentimentos em que este profissional e o grantee (D-016)
  suggestionsAsA          SharingSuggestion[]         @relation("SuggestionProfessionalA")
  suggestionsAsB          SharingSuggestion[]         @relation("SuggestionProfessionalB")
  ownedExercises          Exercise[] // itens de biblioteca proprios do profissional (privados — ADR-0006)
  ownedFoods              Food[] // itens de biblioteca proprios do profissional (privados — ADR-0006)
  ownedFoodGroups         FoodGroup[] // grupos alimentares proprios do profissional (privados — D-114/D-117)
  agendaSettings          ProfessionalAgendaSettings? // fuso das janelas + lembretes (ADR-0012)
  availabilityRules       AvailabilityRule[] // janelas recorrentes (ADR-0012)
  availabilityExceptions  AvailabilityException[] // bloqueios pontuais (ADR-0012)

  @@index([tenantId])
  @@map("professional_profile")
}

/// Especialidade do catalogo fixo da plataforma (D-047). Semeada na migracao.
model Specialty {
  id   String        @id @default(cuid())
  code SpecialtyCode @unique
  name String

  professionals       ProfessionalSpecialty[]
  professionalInvites ProfessionalInvite[] // convites de clinica que ja fixam a especialidade (ADR-0015)
  patientInvites      PatientInvite[]
  bonds               Bond[]
  consents            Consent[]
  sharingSuggestions  SharingSuggestion[]
  exercises           Exercise[] // exercicios de biblioteca desta especialidade (ADR-0006)
  foods               Food[] // alimentos de biblioteca desta especialidade (ADR-0006)
  foodGroups          FoodGroup[] // grupos alimentares desta especialidade (D-114 — ADR-0013)

  @@map("specialty")
}

/// Habilitacao do profissional numa especialidade, com status de verificacao
/// individual pela plataforma (D-046/D-010/D-051).
model ProfessionalSpecialty {
  id                    String             @id @default(cuid())
  professionalProfileId String
  specialtyId           String
  verificationStatus    VerificationStatus @default(PENDING)
  councilDocument       String? // registro no conselho (CREF/CRN/CRM)
  /// UF do conselho (estadual): "CRM 12345" SEM UF nao identifica ninguem, e e o
  /// que vai impresso na receita (D-126). Viaja junto de councilDocument; nulavel,
  /// acompanha ele. A EXIGENCIA de preenchimento (junto com o verificationStatus
  /// VERIFIED) e da aplicacao — D-051/TODO(D-010) —, nao da coluna.
  councilState          BrazilianState?
  /// RQE — Registro de Qualificacao de Especialista (D-126). So faz sentido na
  /// especialidade MEDICINE (ao lado do CRM); "so quando MEDICINE" e regra entre a
  /// linha e o enum, imposta na aplicacao/Zod, nao no banco. Nulo nas demais.
  rqe                   String?
  /// Especialidade medica (D-137 — ADR-0015). So preenchida quando `specialty` e
  /// MEDICINE; nula nas demais. A EXIGENCIA (obrigatoria sse MEDICINE) e da
  /// aplicacao/Zod (superRefine), nao da coluna — por isso nulavel.
  medicalSpecialty      MedicalSpecialty?
  createdAt             DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(3)

  professionalProfile ProfessionalProfile   @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  specialty           Specialty             @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  services            ProfessionalService[] // oferta por especialidade (D-109 — ADR-0012)

  @@unique([professionalProfileId, specialtyId])
  @@index([specialtyId])
  @@map("professional_specialty")
}

/// Perfil de paciente (1:1 com a conta). Dados corporais globais e vinculos
/// entram na fase do dominio de paciente.
model PatientProfile {
  id                    String    @id @default(cuid())
  accountId             String    @unique
  /// Ultima atualizacao cadastral (D-095 — ADR-0010). A cada 6 meses o aluno
  /// revisa os dados; a varredura e de worker e usa este campo como base. Nulo =
  /// nunca revisado desde o cadastro. O "objetivo mudou?" a cada plano novo vive
  /// em WorkoutPlan.goal, no momento natural da montagem.
  lastCadastralReviewAt DateTime? @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  account            Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  bonds              Bond[]
  consents           Consent[] // autorizacoes que ESTE paciente concedeu (D-016)
  sharingSuggestions SharingSuggestion[] // sugestoes do motor para este paciente (D-017)

  @@index([lastCadastralReviewAt]) // varredura da revisao semestral (worker — D-095)
  @@map("patient_profile")
}

// ---------------------------------------------------------------------------
// Convite admin de clinica -> profissional (D-014/D-048/D-049)
// ---------------------------------------------------------------------------

/// Convite de um admin de clinica para um profissional. E a UNICA porta de
/// entrada de um profissional numa clinica (D-048): quem se cadastra por fora
/// vira solo. Distinto do convite profissional->paciente (D-005, fase do
/// dominio de paciente). O token de uso unico e guardado SO como hash — o
/// segredo em claro nunca e persistido (mesma disciplina dos tokens de auth,
/// D-029). Expira em 7 dias por padrao (definido na aplicacao), espelhando a
/// convencao do convite de paciente (D-055). Datas em UTC (D-067).
model ProfessionalInvite {
  id               String            @id @default(cuid())
  tenantId         String // clinica que convida (escopo de tenant obrigatorio — D-002)
  email            String // e-mail do profissional convidado
  status           InviteStatus      @default(PENDING)
  tokenHash        String            @unique // sha256 do token de uso unico (nunca em claro)
  expiresAt        DateTime          @db.Timestamptz(3) // validade (default de 7 dias aplicado na camada de aplicacao)
  /// A clinica define a especialidade + o conselho JA no convite (ADR-0015/D-137):
  /// o aceite le tudo daqui e nasce a ProfessionalSpecialty; o profissional nao
  /// reinforma nada. Nulaveis por serem ADITIVOS — convite legado (pre-ADR-0015)
  /// nasceria sem specialtyId e e tratado como INVALIDO no aceite (guarda
  /// defensiva; nao ha convite legado real no banco). FK Restrict: nao deixa
  /// apontar para especialidade fora do catalogo fixo (D-047).
  specialtyId      String?
  councilDocument  String? // registro no conselho (CREF/CRN/CRM) — formato (D-138)
  councilState     BrazilianState? // UF do conselho (D-126)
  medicalSpecialty MedicalSpecialty? // so quando specialty e MEDICINE (regra na app/Zod)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  specialty Specialty? @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([specialtyId])
  @@map("professional_invite")
}

// ---------------------------------------------------------------------------
// Seat de ESTAGIARIO (D-142) — convite + perfil supervisionado
// ---------------------------------------------------------------------------

/// Seat de ESTAGIARIO (spec §1/§6 — D-142). Modelo PROPRIO, nao um
/// ProfessionalProfile com flag: o estagiario e ESTUDANTE, nao tem conselho, e
/// so existe SUPERVISIONADO. Nao ha coluna `seatType`: a existencia da linha JA
/// e o fato "este seat e STUDENT_INTERN" — uma coluna de valor unico criaria
/// DUAS representacoes do mesmo estado (o anti-padrao que o schema evita em
/// biologicalSex — D-103). O rotulo `STUDENT_INTERN` vive no DTO da API.
///
/// `supervisorProfessionalProfileId` e NOT NULL de proposito: "estagiario sem
/// responsavel" e um estado INVALIDO que o schema torna IRREPRESENTAVEL —
/// exercicio ilegal da profissao se solto (art. 47 DL 3.688/1941). onDelete
/// Restrict no supervisor: nao se apaga o responsavel por baixo de um estagiario.
///
/// D-143: o seat existe em QUALQUER tenant-empresa (CLINIC ou ACADEMIA). Nao e a
/// vertical do tenant que decide quem pode ter estagiario — e o CONSELHO do
/// responsavel bater com a `area` do estagiario. Uma clinica com um CREF no
/// quadro pode ter estagiario de educacao fisica; uma academia com um CRN, de
/// nutricao.
///
/// DERIVACAO CONGELADA (D-142): a capacidade do estagiario DERIVA do conselho
/// ativo do supervisor — nao ha capacidade propria, nem copia do CREF aqui. Se o
/// supervisor perde o vinculo/o conselho, o estagiario perde a capacidade. A
/// derivacao e feita em LEITURA (segue esta relacao), nunca materializada e
/// nunca por job — materializar reintroduziria a divergencia que a FK evita.
/// "Ativo" hoje = conselho PREENCHIDO em formato (D-138); a verificacao de
/// registro ativo de verdade segue deferida — TODO(D-010).
model InternProfile {
  id                              String     @id @default(cuid())
  accountId                       String     @unique
  /// Empresa (CLINIC ou ACADEMIA) a que o estagiario pertence (escopo de tenant
  /// obrigatorio — D-002).
  tenantId                        String
  /// Area de estagio (D-143), fixada no CONVITE — o estagiario nao escolhe, do
  /// mesmo jeito que nao escolhe o responsavel. E o que substitui o conselho
  /// proprio, que ele NAO tem em area nenhuma.
  area                            InternArea
  /// Responsavel: profissional do MESMO tenant com o conselho correspondente a
  /// `area` (D-143). A elegibilidade e checada na aplicacao no momento do
  /// convite; a FK garante que o alvo existe e nao some depois.
  supervisorProfessionalProfileId String

  displayName String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  account    Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  supervisor ProfessionalProfile @relation("InternSupervisor", fields: [supervisorProfessionalProfileId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([supervisorProfessionalProfileId])
  @@map("intern_profile")
}

/// Convite empresa->estagiario (Fase A — D-142/D-143). Distinto do
/// ProfessionalInvite: NAO carrega especialidade nem conselho (o estagiario nao
/// tem conselho) e CARREGA o responsavel, NOT NULL — a mesma regra do
/// InternProfile aplicada uma etapa antes, para que nem o convite consiga
/// representar um estagiario sem responsavel. Token de uso unico guardado SO
/// como hash (mesma disciplina de ProfessionalInvite/D-029); expira e e
/// revogavel pelo admin.
model InternInvite {
  id       String  @id @default(cuid())
  tenantId String
  email    String
  /// Nome informado pela academia no pre-cadastro — facilita o convite. O nome
  /// definitivo (civil) vem no aceite, da propria pessoa.
  name     String?

  /// Area de estagio definida pela empresa (D-143). Viaja no convite junto do
  /// responsavel: os dois sao decisao da empresa, nao do estagiario.
  area InternArea

  status                          InviteStatus @default(PENDING)
  tokenHash                       String       @unique
  expiresAt                       DateTime     @db.Timestamptz(3)
  supervisorProfessionalProfileId String

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supervisor ProfessionalProfile @relation("InternInviteSupervisor", fields: [supervisorProfessionalProfileId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([supervisorProfessionalProfileId])
  @@map("intern_invite")
}

// ---------------------------------------------------------------------------
// Seat administrativo de RECEPCAO (D-156 — ADR-0015, spec §2/§4.5)
// ---------------------------------------------------------------------------

/// Seat ADMINISTRATIVO de recepcao. Pre-cadastrado por convite do admin da
/// empresa (CLINIC ou ACADEMIA); nunca por autocadastro (spec §1).
///
/// NAO ATENDE. Recepcao opera agenda e cadastro — dado OPERACIONAL (D-015) —, e
/// NUNCA acessa dado clinico (anamnese, avaliacao, prontuario, prescricao). Por
/// isso o modelo nao tem conselho, nem especialidade, nem supervisor: os tres
/// existem para quem atende, e representa-los aqui sugeriria uma capacidade
/// clinica que este seat nao tem.
///
/// SEM coluna `seatType`: a existencia da linha JA e o fato (mesma doutrina de
/// InternProfile — D-103, duas representacoes do mesmo estado divergem). O
/// rotulo `RECEPTION` vive no DTO, em @fitvo/validation.
///
/// SEM ClinicMembership: a membership so tem o papel CLINIC_ADMIN, entao dar
/// uma a recepcao lhe daria poder de admin da empresa — exatamente o oposto de
/// um seat administrativo restrito. O vinculo da recepcao com o tenant E esta
/// linha.
model ReceptionProfile {
  id String @id @default(cuid())

  accountId String @unique
  /// Empresa (CLINIC ou ACADEMIA) a que a recepcao pertence (escopo de tenant
  /// obrigatorio — D-002).
  tenantId  String

  displayName String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Restrict como no InternProfile: apagar a empresa nao pode apagar em
  /// silencio o registro de quem trabalhou nela.
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("reception_profile")
}

/// Convite admin->recepcao (Fase A — D-156). Mesmo molde do InternInvite, MENOS
/// area e responsavel: recepcao nao estagia sob ninguem. Token de uso unico
/// guardado SO como hash (mesma disciplina de ProfessionalInvite/InternInvite);
/// expira e e revogavel pelo admin.
model ReceptionInvite {
  id       String  @id @default(cuid())
  tenantId String
  email    String
  /// Nome informado pela empresa no pre-cadastro — facilita o convite. O nome
  /// definitivo (civil) vem no aceite, da propria pessoa.
  name     String?

  status    InviteStatus @default(PENDING)
  tokenHash String       @unique
  expiresAt DateTime     @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  /// Cascade como no InternInvite: convite e registro TRANSITORIO (e-mail +
  /// hash de token), nao prova de nada — some com a empresa.
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("reception_invite")
}

// ---------------------------------------------------------------------------
// Convite profissional -> paciente + Vinculo (D-006/D-052/D-053/D-055)
// ---------------------------------------------------------------------------

/// Convite de um profissional para um paciente (D-006), direcionado a UMA
/// especialidade (D-052): o aceite abre o vinculo naquele "ambiente". Distinto
/// do convite admin->profissional (ProfessionalInvite). O token de uso unico e
/// guardado SO como hash — o segredo em claro nunca e persistido (mesma
/// disciplina dos tokens de auth, D-029). Expira em 7 dias e e reenviavel
/// (D-055): o reenvio rotaciona o token e estende a validade na mesma linha.
/// tenantId denormalizado = o tenant do profissional (escopo obrigatorio — D-002).
/// Datas em UTC (D-067).
model PatientInvite {
  id                    String       @id @default(cuid())
  tenantId              String // tenant do profissional que convida (escopo — D-002)
  professionalProfileId String // profissional que convida (D-006)
  specialtyId           String // especialidade-alvo do vinculo futuro (D-052)
  email                 String // e-mail do paciente convidado
  /// Modalidade do vinculo FUTURO (D-101 — ADR-0011). Vive aqui porque o
  /// profissional a escolhe NO CONVITE e o vinculo nasce do aceite: sem carrega-la
  /// aqui, nao haveria como o Bond nascer com ela. Propagada em acceptInvite.
  modality              CareModality
  status                InviteStatus @default(PENDING)
  tokenHash             String       @unique // sha256 do token de uso unico (nunca em claro)
  expiresAt             DateTime     @db.Timestamptz(3) // validade (7 dias por padrao, aplicado na aplicacao — D-055)
  createdAt             DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime     @updatedAt @db.Timestamptz(3)

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  specialty           Specialty           @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([professionalProfileId, status])
  @@index([email])
  @@map("patient_invite")
}

/// Vinculo = paciente <-> (profissional + especialidade) (D-052). E a entidade
/// central: anamnese, avaliacoes, treinos, cobrancas penduram no vinculo (fases
/// seguintes). Cada vinculo materializa um "ambiente" na UX do paciente. A
/// tripla (paciente, profissional, especialidade) e unica — "Leo educador" e
/// "Leo nutricionista" sao vinculos distintos. Encerrar vira ARQUIVO, nunca
/// apaga (D-053). tenantId denormalizado = tenant do profissional (escopo — D-002).
model Bond {
  id                    String       @id @default(cuid())
  tenantId              String // tenant do profissional (escopo denormalizado — D-002)
  patientProfileId      String
  professionalProfileId String
  specialtyId           String
  /// Modalidade do atendimento (D-101 — ADR-0011). Nasce do convite e e MUTAVEL
  /// (paciente muda de cidade e migra para online). Muda-la NAO invalida a
  /// anamnese existente nem reabre o gate — so muda os fluxos dali pra frente.
  /// NAO ha flag de gate espelhada aqui: o gate le do Anamnesis (fonte unica de
  /// verdade — D-093), senao poderia divergir.
  modality              CareModality
  status                BondStatus   @default(ACTIVE)
  createdAt             DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime     @updatedAt @db.Timestamptz(3)
  archivedAt            DateTime?    @db.Timestamptz(3) // momento do encerramento (UTC), null enquanto ativo (D-053)

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientProfile      PatientProfile      @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  specialty           Specialty           @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  charges             Charge[] // cobrancas penduram no vinculo (Fluxo B — ADR-0004)
  workoutPlans        WorkoutPlan[] // N planos ATIVOS simultaneos por vinculo (D-079)
  workouts            Workout[] // treinos isolados por vinculo (ADR-0006/ADR-0001)
  workoutSessions     WorkoutSession[] // execucoes/check-ins isolados por vinculo (D-086)
  formAnalyses        FormAnalysis[] // analises de forma isoladas por vinculo (D-088)
  mealPlans           MealPlan[] // planos alimentares isolados por vinculo (ADR-0006/ADR-0001)
  mealLogs            MealLog[] // registros de refeicao isolados por vinculo (D-118 — ADR-0013)
  encounters          Encounter[] // atendimentos isolados por vinculo (ADR-0006/ADR-0001)
  medicalRecord       MedicalRecord? // prontuario (um por vinculo — ADR-0006/ADR-0001)
  anamnesis           Anamnesis? // GATE: uma anamnese por vinculo (D-093/D-094)
  assessments         Assessment[] // avaliacao/medidas isoladas por vinculo (ADR-0006/ADR-0001)
  progressPhotos      ProgressPhoto[] // fotos de evolucao isoladas por vinculo (ADR-0006/ADR-0001)
  attendances         Attendance[] // atendimentos (ticket) isolados por vinculo (D-096)
  appointments        Appointment[] // agendamentos isolados por vinculo (ADR-0012)

  @@unique([patientProfileId, professionalProfileId, specialtyId])
  /// Alvo da FK COMPOSTA do Appointment. Redundante como chave (id ja e unico),
  /// mas e o que torna `Appointment.professionalProfileId` divergente do vinculo
  /// IRREPRESENTAVEL em vez de apenas proibido (ADR-0012).
  @@unique([id, professionalProfileId])
  @@index([tenantId])
  @@index([professionalProfileId, status])
  @@index([patientProfileId, status])
  @@map("bond")
}

// ---------------------------------------------------------------------------
// Consentimento + motor de compartilhamento (D-016/D-017/D-054 — ADR-0003)
// ---------------------------------------------------------------------------

/// Consentimento = autorizacao do PACIENTE para que um profissional (o
/// "grantee") acesse seus dados numa especialidade (D-016). Dominio de primeira
/// classe: compartilhamento entre profissionais e SEMPRE autorizado pelo
/// paciente, nunca automatico (ADR-0003).
///
/// DEFAULTS documentados:
/// - Granularidade = por (paciente + profissional que recebe + especialidade).
///   E o escopo minimo que a ADR pede ("granular, por profissional") somado a
///   dimensao de especialidade do produto multi-especialidade.
/// - Titularidade = o paciente. Diferente das demais entidades, o Consent NAO e
///   escopado por tenant: e o ato do proprio paciente e pode CRUZAR tenants (os
///   profissionais do paciente podem viver em tenants distintos). A chave de
///   escopo aqui e o patientProfileId, nao um tenantId. O isolamento de tenant
///   (D-002) continua valendo em toda OUTRA query do sistema.
/// - Unicidade = um consentimento por tripla (paciente, grantee, especialidade).
///   Revogar + reconceder REUSA/REABRE a MESMA linha (ACTIVE<->REVOKED), em vez
///   de inserir varias — escolha mais simples e sem historico duplicado nesta
///   fase (o historico fino de consentimento fica para uma fase futura).
/// Datas em UTC (D-067).
model Consent {
  id                           String        @id @default(cuid())
  patientProfileId             String // titular do dado (chave de escopo — nao ha tenantId aqui de proposito)
  granteeProfessionalProfileId String // profissional que RECEBE o acesso
  specialtyId                  String // escopo do que pode ser compartilhado (granular por especialidade)
  status                       ConsentStatus @default(ACTIVE)
  grantedAt                    DateTime      @default(now()) @db.Timestamptz(3)
  revokedAt                    DateTime?     @db.Timestamptz(3) // preenchido na revogacao (UTC), null enquanto ACTIVE
  createdAt                    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt                    DateTime      @updatedAt @db.Timestamptz(3)

  patientProfile      PatientProfile      @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  granteeProfessional ProfessionalProfile @relation(fields: [granteeProfessionalProfileId], references: [id], onDelete: Cascade)
  specialty           Specialty           @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  @@unique([patientProfileId, granteeProfessionalProfileId, specialtyId])
  @@index([patientProfileId])
  @@index([granteeProfessionalProfileId, status])
  @@map("consent")
}

/// Documento legal (Termos de Uso, Politica de Privacidade) rastreado para
/// aceite obrigatorio (D-025 — LGPD). Uma linha por "tipo" de documento; as
/// VERSOES publicadas vivem em `TermsVersion`. Catalogo fixo hoje (2 slugs),
/// semeado na migracao (mesmo padrao de `Specialty` — D-047).
model TermsDocument {
  id   String            @id @default(cuid())
  slug TermsDocumentSlug @unique

  versions TermsVersion[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("terms_document")
}

/// Versao publicada de um documento (D-025). APPEND-ONLY: nunca atualizada
/// apos criada — o repositorio nao expoe update/delete. `isMaterialChange`
/// distingue mudanca que altera finalidade/compartilhamento/duracao/
/// controlador (LGPD Art. 9 I/II/III/V — forca re-consentimento de quem ja
/// aceitou versao anterior) de um bump so editorial (nao forca). Uma primeira
/// versao e sempre material por definicao. `changeSummary` e exigido pela
/// camada de aplicacao quando `isMaterialChange` — resumo mostrado ao usuario
/// no re-consentimento (LGPD Art. 8 par. 6). `contentHash` prova que o texto
/// efetivamente aceito nao mudou depois do fato (hash do conteudo exato).
model TermsVersion {
  id               String   @id @default(cuid())
  documentId       String
  /// String livre (ex.: data ou semver) — a app decide o esquema, so precisa
  /// ser unica por documento.
  version          String
  isMaterialChange Boolean
  changeSummary    String?
  contentHash      String
  publishedAt      DateTime @db.Timestamptz(3)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  document TermsDocument          @relation(fields: [documentId], references: [id], onDelete: Restrict)
  events   TermsAcceptanceEvent[]

  @@unique([documentId, version])
  @@index([documentId, publishedAt])
  @@map("terms_version")
}

/// Evento IMUTAVEL de aceite ou revogacao de uma versao de termo (D-025) —
/// registro probatorio (LGPD). NUNCA atualizado apos criado: o repositorio so
/// expoe criacao/leitura. `occurredAt` e o instante real da acao (tempo do
/// SERVIDOR, nunca informado pelo cliente); `ipAddress`/`userAgent` vem da
/// requisicao, nunca do body. O status de aceite ATUAL de uma conta para um
/// documento e sempre DERIVADO do ultimo evento (nunca guardado de forma
/// mutavel em nenhuma outra tabela) — ver `TermsApplicationService`.
/// `onDelete: Restrict` em ambas FKs: apagar conta ou versao nao pode apagar
/// prova de consentimento.
model TermsAcceptanceEvent {
  id             String                   @id @default(cuid())
  accountId      String
  termsVersionId String
  type           TermsAcceptanceEventType
  occurredAt     DateTime                 @db.Timestamptz(3)
  ipAddress      String
  userAgent      String
  createdAt      DateTime                 @default(now()) @db.Timestamptz(3)

  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  termsVersion TermsVersion @relation(fields: [termsVersionId], references: [id], onDelete: Restrict)

  @@index([accountId, termsVersionId])
  @@map("terms_acceptance_event")
}

/// Sugestao de compartilhamento = saida do motor orientado a eventos (D-017). Ao
/// abrir um vinculo (bond.created), o worker detecta a SOBREPOSICAO (o paciente
/// passa a ter >=2 profissionais distintos) e cria uma sugestao PENDING para o
/// par recem-sobreposto. IMPORTANTE: a sugestao NAO compartilha nada — a entrega
/// por notificacao (D-028) e o ato de consentir sao passos posteriores.
///
/// DEFAULTS documentados:
/// - O par (professionalA, professionalB) e NORMALIZADO por ordem estavel dos
///   ids (A < B) para que (X,Y) e (Y,X) sejam a mesma sugestao — habilita dedupe.
/// - specialtyId = a especialidade do vinculo que DISPAROU a sobreposicao (o
///   contexto do evento). E o gatilho, nao um escopo de compartilhamento.
/// - Dedupe = a nivel de aplicacao (nao ha PENDING duplicado para o mesmo
///   par+especialidade do mesmo paciente); nao ha unique no banco porque o
///   status faz parte da identidade de negocio (um par ACTED pode voltar a ser
///   sugerido no futuro). Datas em UTC (D-067).
model SharingSuggestion {
  id               String           @id @default(cuid())
  patientProfileId String
  professionalAId  String // par normalizado: professionalAId < professionalBId
  professionalBId  String
  specialtyId      String // especialidade do vinculo que disparou a sugestao
  status           SuggestionStatus @default(PENDING)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)

  patientProfile PatientProfile      @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  professionalA  ProfessionalProfile @relation("SuggestionProfessionalA", fields: [professionalAId], references: [id], onDelete: Cascade)
  professionalB  ProfessionalProfile @relation("SuggestionProfessionalB", fields: [professionalBId], references: [id], onDelete: Cascade)
  specialty      Specialty           @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  @@index([patientProfileId, status])
  @@map("sharing_suggestion")
}

// ---------------------------------------------------------------------------
// Financeiro: planos, assinatura (Fluxo A), cobranca+split (Fluxo B), webhook
// (D-018 a D-021 / D-025 / D-050 / D-056 a D-062 / D-069 — ADR-0004)
// ---------------------------------------------------------------------------

/// Periodicidade de cobranca (D-057/D-060). Periodos longos sao pagos adiantados
/// e podem carregar desconto progressivo — modelado como dado em PlanPrice.
enum Periodicity {
  MONTHLY
  QUARTERLY
  BIANNUAL
  ANNUAL
}

/// Estagio do onboarding da subconta Asaas do tenant (D-050). A subconta e passo
/// OBRIGATORIO do Fluxo B; o walletId so e preenchido quando o onboarding LIVE
/// (gated — sem credenciais Asaas neste repo) e concluido.
enum OnboardingStatus {
  PENDING // sem subconta ainda (walletId nulo)
  IN_PROGRESS // subconta solicitada, aguardando aprovacao Asaas (gated)
  COMPLETED // subconta ativa, walletId preenchido
}

/// Estado da assinatura de plano da plataforma (Fluxo A — D-062). Trial de 7 dias
/// antes de ACTIVE; a regua (worker) transiciona ACTIVE->PAST_DUE->SUSPENDED.
/// SUSPENDED != exclusao (D-021): dados retidos.
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

/// Metodo de cobranca (D-056). Espelha ChargeMethod de @fitvo/payments (o
/// adaptador Asaas normaliza entre o enum do banco e a string do gateway).
enum ChargeMethod {
  BOLETO
  PIX
  CREDIT_CARD
}

/// Estado da cobranca (Fluxo B — D-019/D-020). Espelha ChargeStatus de
/// @fitvo/payments. REFUNDED cobre o reembolso voluntario (D-025); a politica
/// juridica de estorno/arrependimento e GATED (advogado — ADR-0004).
enum ChargeStatus {
  PENDING
  CONFIRMED
  RECEIVED
  OVERDUE
  REFUNDED
  FAILED
}

/// Plano Nivel 1 (plataforma -> profissional/clinica — D-060). Os PRECOS sao
/// dado configuravel (PlanPrice), NUNCA hardcoded; o catalogo comercial real e
/// uma decisao humana (GATED) — nao semeamos precos reais nesta fase.
model Plan {
  id        String   @id @default(cuid())
  code      String   @unique // identificador estavel (ex.: "solo", "clinic")
  name      String
  tier      String // faixa comercial (ex.: intern/solo/clinic) — texto livre nesta fase
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  prices        PlanPrice[]
  subscriptions Subscription[]

  @@map("plan")
}

/// Preco de um plano por periodicidade (D-057/D-060). Filho de Plano para que
/// periodos longos carreguem descontos progressivos como DADO. Dinheiro sempre
/// em centavos inteiros (D-069). Valores comerciais reais sao GATED.
model PlanPrice {
  id          String      @id @default(cuid())
  planId      String
  periodicity Periodicity
  amountCents Int // centavos inteiros (D-069)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, periodicity])
  @@map("plan_price")
}

/// Subconta Asaas + taxa por tenant (D-050/D-058/D-059). Escopo = tenant (solo
/// ou clinica). A taxa e configuravel por tenant (solo paga mais, clinica menos)
/// e guardada em BASIS POINTS inteiros (1 bp = 0,01%; ex.: 500 = 5,00%) para
/// manter tudo inteiro (D-069). O valor comercial real e GATED; default 0.
/// asaasWalletId fica nulo ate o onboarding LIVE da subconta (GATED — sem
/// credenciais Asaas neste repo).
model PaymentAccount {
  id               String           @id @default(cuid())
  tenantId         String           @unique
  asaasWalletId    String? // preenchido no onboarding LIVE (GATED)
  feeBasisPoints   Int              @default(0) // taxa FITVO em basis points (config comercial — GATED)
  onboardingStatus OnboardingStatus @default(PENDING)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("payment_account")
}

/// Assinatura de plano da plataforma (Fluxo A — D-062). Idempotencia obrigatoria
/// (D-035): idempotencyKey unica evita cobranca duplicada em retry. Uma
/// assinatura NAO-terminal por tenant (regra na aplicacao). asaasSubscriptionId
/// nulo enquanto o gateway LIVE nao e chamado (GATED — usa FakePaymentGateway).
/// Datas em UTC (D-067).
model Subscription {
  id                  String             @id @default(cuid())
  tenantId            String
  planId              String
  periodicity         Periodicity
  status              SubscriptionStatus @default(TRIALING)
  asaasSubscriptionId String? // preenchido pelo gateway LIVE (GATED)
  idempotencyKey      String             @unique // idempotencia financeira (D-035)
  currentPeriodEnd    DateTime?          @db.Timestamptz(3) // vencimento do periodo atual (base da regua)
  trialEndsAt         DateTime?          @db.Timestamptz(3) // fim do trial de 7 dias (D-062)
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([status, currentPeriodEnd]) // varredura da regua de cobranca (worker)
  @@map("subscription")
}

/// Cobranca paciente -> profissional (Fluxo B — D-019/D-050). Emitida contra um
/// VINCULO (bond — ADR-0004), avulsa ou recorrente (recurring + periodicity —
/// D-057). O split e capturado como DADO (professionalWalletId + platformFeeCents)
/// para preservar o financeiro granular mesmo dentro da clinica. Idempotencia
/// obrigatoria (D-035): idempotencyKey unica. Dinheiro em centavos (D-069). O
/// chargeback (D-020) e apenas um estado futuro — modelado via status, sem logica
/// de contestacao (risco do profissional — ADR-0004). Datas em UTC (D-067).
model Charge {
  id                   String       @id @default(cuid())
  tenantId             String
  bondId               String
  amountCents          Int // centavos inteiros (D-069)
  method               ChargeMethod
  status               ChargeStatus @default(PENDING)
  recurring            Boolean      @default(false) // cobranca recorrente (D-057)
  periodicity          Periodicity? // preenchido quando recurring
  asaasChargeId        String?      @unique // id no Asaas (GATED — nulo com o Fake)
  idempotencyKey       String       @unique // idempotencia financeira (D-035)
  professionalWalletId String? // subconta destino do split (nulo ate onboarding — GATED)
  platformFeeCents     Int          @default(0) // taxa FITVO retida, capturada como dado (D-061)
  description          String?
  dueDate              DateTime?    @db.Timestamptz(3)
  createdAt            DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bond   Bond   @relation(fields: [bondId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([bondId])
  @@map("charge")
}

/// Ledger de idempotencia de webhooks Asaas (D-035). Um evento reentregue e
/// no-op: asaasEventId unico dedupe a reprocessagem. Guarda o payload cru para
/// auditoria/reprocessamento manual. Datas em UTC (D-067).
model WebhookEvent {
  id           String   @id @default(cuid())
  asaasEventId String   @unique // id do evento no Asaas (chave de dedupe)
  type         String // tipo do evento (ex.: PAYMENT_RECEIVED)
  payload      Json // payload cru para auditoria
  processedAt  DateTime @default(now()) @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@map("webhook_event")
}

// ---------------------------------------------------------------------------
// Conteudo. O D-063 (detalhe fino) esta PARCIALMENTE FECHADO:
//
//   TREINO — FECHADO (ADR-0009, D-079 a D-092). Colunas TIPADAS; o `detail Json?`
//   foi REMOVIDO de Exercise/Workout/WorkoutItem. Nao reintroduzir Json aqui: o
//   merge por campo do offline-first (D-099/ADR-0010) e IMPOSSIVEL sobre um blob
//   Json — a tipagem deixou de ser preferencia e virou pre-requisito tecnico.
//
//   NUTRICAO / MEDICINA — ABERTO. Food/MealPlan/Encounter/MedicalRecord/
//   Prescription seguem com `detail Json?` + TODO(D-063) ate a decisao de produto
//   com referencia propria (Dietbox). NAO inventar.
//
//   ANAMNESE — FECHADA E TIPADA (D-102/D-103, ADR-0011). O `detail Json?` morreu:
//   nucleo + modulo TREINO em colunas tipadas, com AUTORIA POR SECAO. Os modulos
//   de nutricao e nutrologia entram na fase de nutricao/medicina (nutrologia
//   depende de exames laboratoriais — D-076 — que ainda nao existem).
//
//   AVALIACAO/MEDIDAS (Assessment) — ABERTO. O ADR-0011 fechou a ANAMNESE, nao a
//   taxonomia de medidas, que segue deferida (D-063). E aqui mora a antropometria
//   (adipometria/bioimpedancia): bloco visivel no FLUXO da anamnese, dado no
//   Assessment. Segue FORA do escopo de sync offline, entao o Json nao conflita
//   com o D-099.
//
// Modelos ligados a vinculo (Bond) carregam tenantId denormalizado para escopo
// (D-002) e sao isolados POR VINCULO (ADR-0001). Bibliotecas (Exercise/Food) =
// base compartilhada da plataforma + itens do profissional (privados por
// padrao), com DELECAO SEMPRE LOGICA (D-089). Datas em UTC (D-067).
// ---------------------------------------------------------------------------

/// Visibilidade de um item de biblioteca (D-063 / ADR-0006). PLATFORM = base
/// compartilhada da plataforma (sem dono); PRIVATE = item proprio do profissional
/// (privado por padrao). O owner FK + visibilidade juntos modelam a regra.
enum LibraryVisibility {
  PLATFORM // item da biblioteca compartilhada da plataforma (sem dono)
  PRIVATE // item proprio do profissional, privado por padrao
}

/// Ciclo de vida de um item de biblioteca (D-089 / ADR-0009). DELECAO E SEMPRE
/// LOGICA — nunca fisica. DISCONTINUED some da busca mas CONTINUA funcionando
/// nos treinos que ja o usam: o historico permanece integro. Regra geral do
/// sistema (vale para exercicio, alimento, plano comercial, especialidade).
enum LibraryItemStatus {
  ACTIVE // aparece na busca; pode ser adicionado a treinos novos
  DISCONTINUED // fora da busca; segue funcionando no historico (nunca apagar)
}

/// Organizacao de um plano de treino (D-080 / ADR-0009). Escolha POR PLANO, nao
/// global: as duas formas coexistem no produto.
enum PlanOrganization {
  LETTER // A/B/C — o aluno executa na ordem que quiser
  WEEKDAY // dias da semana — cada treino tem dia marcado
}

/// Estado de um plano de treino (D-083/D-084 / ADR-0009). SCHEDULED = montado e
/// programado para liberacao futura (releaseAt); EXPIRED = validade vencida. As
/// transicoes SCHEDULED->ACTIVE e ACTIVE->EXPIRED sao reguas de worker: o aluno
/// NUNCA fica sem nada silenciosamente (D-083).
enum WorkoutPlanStatus {
  DRAFT // em montagem pelo profissional; invisivel ao aluno
  SCHEDULED // programado para liberacao futura (releaseAt — D-084)
  ACTIVE // liberado ao aluno
  EXPIRED // validade vencida (D-083); aluno ve "aguarde novo treino"
  ARCHIVED // encerrado; historico preservado (D-053)
}

/// Dia da semana de um treino quando o plano e organizado por dia (D-080). Enum
/// em vez de Int 1..7 para que o estado invalido seja irrepresentavel.
enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

/// Tecnica de uma serie (D-081 / ADR-0009). O enum guarda o CODIGO; o label
/// exibido vive no i18n (D-066) — trocar a redacao e traducao, nao migracao.
/// Catalogo deliberadamente MINIMO: so o que o ADR-0009 fundamenta (normal e
/// drop-set). Adicionar tecnica nova exige migracao — raro e aceitavel; nao
/// inventamos taxonomia aqui.
///
/// NOTA: bi-set/tri-set/circuito NAO sao tecnicas de serie — sao ESTRUTURA
/// (agrupamento de itens via WorkoutItem.supersetGroup — D-082). Modela-los
/// tambem aqui criaria duas fontes de verdade para conjugacao.
enum SetTechnique {
  NORMAL
  DROP_SET
}

/// Reacao rapida da avaliacao de treino (D-087 / ADR-0009). O enum guarda o
/// CODIGO; o label e o emoji ("morri 💀", "voei 🚀", "perna bamba 🦵") vivem no
/// i18n/config (D-066), nunca no enum.
enum WorkoutReaction {
  DIED // "morri"
  FLEW // "voei"
  WOBBLY_LEGS // "perna bamba"
}

/// Estado de uma sessao de treino executada (D-086 / ADR-0009). IN_PROGRESS
/// existe porque a execucao e offline-first: a sessao nasce no device e fica
/// pendente ate sincronizar (D-099 — "execucoes pendentes" estao no escopo de
/// sync).
enum WorkoutSessionStatus {
  IN_PROGRESS // iniciada (pode viver so no device ate o sync)
  COMPLETED // concluida — conta como CHECK-IN do aluno (D-086)
}

/// Estagio da pre-analise de forma pela IA (D-088 / ADR-0009). A IA apenas
/// PRE-analisa; nada chega ao aluno sem validacao do profissional.
enum FormAnalysisAiStatus {
  PENDING // video enviado, aguardando pre-analise
  ANALYZED // pre-analise concluida, aguardando o profissional
  FAILED // pre-analise falhou (o profissional segue podendo responder)
}

/// Validacao do profissional sobre a pre-analise da IA (D-088 / ADR-0009). O
/// humano fica no circuito (D-023): a devolutiva so existe para o aluno quando
/// APPROVED. IA nao fala de execucao com leigo sem o responsavel tecnico.
enum FormAnalysisReviewStatus {
  PENDING // na fila do profissional
  APPROVED // validado — a devolutiva pode chegar ao aluno
  REJECTED // descartado pelo profissional
}

/// Estado da anamnese de um vinculo (D-093/D-094 — ADR-0010). E o GATE: sem
/// ANSWERED o profissional nao monta o plano e o aluno ve o que falta fazer
/// (nunca tela morta). O gate e satisfeito INDEPENDENTE de quem preencheu
/// (D-102, ADR-0011) — inclusive quando a anamnese nasce do profissional na
/// consulta presencial.
enum AnamnesisStatus {
  PENDING // gate fechado: anamnese ainda nao respondida
  ANSWERED // gate aberto: o profissional pode montar o plano
}

/// Modalidade de atendimento de um VINCULO (D-101 — ADR-0011). ESTRUTURANTE:
/// define o fluxo da anamnese e a UX do gate (dizer "responda sua anamnese" a um
/// paciente PRESENCIAL esta errado — o profissional preenche na consulta).
///
/// Definida pelo PROFISSIONAL (quem sabe como atende; o paciente nao escolhe a
/// modalidade do servico que contrata), NO CONVITE — por isso PatientInvite
/// tambem a carrega e propaga no aceite. E MUTAVEL: o paciente muda de cidade e
/// migra para online; forcar vinculo novo quebraria o historico (D-053) sem
/// ganho. Mudar NAO invalida a anamnese existente nem reabre o gate.
enum CareModality {
  ONLINE // paciente preenche a anamnese sozinho; pre-requisito do gate
  PRESENCIAL // profissional preenche com o paciente na frente, na consulta
  HIBRIDO // paciente preenche o que sabe; profissional refina no presencial
}

/// Autor de uma SECAO da anamnese (D-102 — ADR-0011). RASTREIO OBRIGATORIO: e
/// documento de prontuario, e "o paciente DECLAROU X" tem peso juridico
/// diferente de "o profissional AFERIU Y". Sem autoria o documento mistura
/// declaracao com afericao e perde valor probatorio.
///
/// Granularidade POR SECAO, nao por campo: o peso juridico vive no bloco;
/// ninguem vai a juizo discutir quem preencheu "dorme quantas horas". Por campo
/// dobraria o schema ou exigiria tabela de auditoria — custo sem retorno.
enum AnamnesisAuthor {
  PATIENT // declarado pelo paciente
  PROFESSIONAL // preenchido/aferido pelo profissional
}

/// Estado de um atendimento (D-096 — ADR-0010). Fica PENDING ate ser resolvido;
/// as RESOLVED seguem visiveis ("mostra tambem as concluidas").
enum AttendanceStatus {
  PENDING // aberto, aguardando resolucao
  RESOLVED // concluido — gera ticket com avaliacao (D-096)
}

/// Tipo de notificacao (D-097 — ADR-0010). Notificacao e PILAR DE RETENCAO, nao
/// acessorio. Os casos sao exatamente os fundamentados no ADR-0010; nao
/// inventar. O texto exibido vive no i18n (D-066), nunca no enum.
enum NotificationType {
  WORKOUT_DAY // dia de treino
  PLAN_EXPIRING // plano vencendo/vencido (D-083)
  NEW_PLAN_AVAILABLE // plano liberado — agendado (D-084) ou novo (D-186 — ADR-0019)
  ATTENDANCE_UNANSWERED // mensagem sem resposta (D-096)
  INVITE_RECEIVED // convite recebido
  CHARGE // cobranca
  ACHIEVEMENT // conquista/meta batida
  APPOINTMENT_REMINDER // lembrete de consulta, N horas antes (D-108 — ADR-0012)
  APPOINTMENT_CONFIRMATION // pedido de confirmacao de presenca, com acao direta (D-108)
}

// --- Treino ----------------------------------------------------------------

/// Grupo muscular — TABELA-PAI, nao enum (D-164 — ADR-0009). O catalogo vive
/// como LINHA: adicionar/renomear grupo e dado, nao migracao de enum. Por isso
/// `code` e String (um enum reintroduziria exatamente a migracao que o D-164
/// rejeita); o label exibido vive no i18n (D-066) e `name` e so o fallback
/// pt-BR.
///
/// Catalogo GLOBAL da plataforma (bucket B — padrao de Specialty): SEM coluna
/// tenantId. Todo tenant enxerga o mesmo catalogo; nao ha grupo muscular "de um
/// tenant" (o D-166 nao pede — a base comum e legitimamente sem dono).
///
/// DELECAO E LOGICA (D-089, aplicado pelo D-164): grupo DISCONTINUED some da
/// busca mas segue valido nos exercicios que ja o referenciam.
model MuscleGroup {
  id           String            @id @default(cuid())
  code         String            @unique // codigo estavel (PEITO, TRICEPS...); label no i18n (D-066)
  name         String // fallback pt-BR do label
  displayOrder Int               @default(0) // ordem de exibicao do catalogo (atributo que so a tabela hospeda — D-164)
  status       LibraryItemStatus @default(ACTIVE) // delecao logica (D-089)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)

  primaryOfExercises   Exercise[]                     @relation("ExercisePrimaryMuscleGroup")
  secondaryOfExercises ExerciseSecondaryMuscleGroup[]

  @@index([status, displayOrder]) // busca so devolve ACTIVE, na ordem do catalogo
  @@map("muscle_group")
}

/// Grupo muscular SECUNDARIO de um exercicio (N:N — D-164). Existe como tabela
/// de juncao propria (e nao como relacao implicita do Prisma) para carregar o
/// @@unique e os indices explicitos: "buscar por triceps" tem que achar supino
/// inclinado, entao o lado do grupo precisa de indice proprio.
///
/// O grupo PRIMARIO NAO mora aqui — e FK direta em Exercise. Um exercicio tem
/// exatamente um dominante (D-164: agrupar por grupo dominante e calcular volume
/// por grupo sao indicadores que o D-092 pressupoe) e N secundarios.
model ExerciseSecondaryMuscleGroup {
  exerciseId    String
  muscleGroupId String
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  exercise    Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  muscleGroup MuscleGroup @relation(fields: [muscleGroupId], references: [id], onDelete: Restrict)

  @@id([exerciseId, muscleGroupId])
  @@index([muscleGroupId]) // busca por grupo secundario (D-164)
  @@map("exercise_secondary_muscle_group")
}

/// Item da biblioteca de exercicios (D-063/D-089/D-091 — ADR-0009). Base
/// compartilhada da plataforma (ownerProfessionalProfileId nulo + visibility
/// PLATFORM) OU item proprio do profissional (owner preenchido + PRIVATE por
/// padrao). specialtyId estrutural (ex.: TRAINING).
///
/// SEPARACAO DE RESPONSABILIDADE (D-089): a BIBLIOTECA guarda o que o exercicio
/// E (nome, descricao, video, MUSCULO); o TREINO guarda o que foi PRESCRITO
/// (carga, serie, tecnica — em WorkoutSet). Editar a biblioteca propaga para
/// todo o app e NUNCA reescreve a prescricao.
///
/// DELECAO E LOGICA (D-089): `status` DISCONTINUED tira da busca sem quebrar os
/// treinos que ja usam o item. Nunca DELETE fisico.
///
/// TAXONOMIA DE MUSCULO (D-164 — fecha o gap que este comentario registrava como
/// pendente): grupo PRIMARIO obrigatorio (FK) + N SECUNDARIOS (N:N via
/// ExerciseSecondaryMuscleGroup), catalogo em TABELA (MuscleGroup), nunca enum.
///
/// ESCOPO — POR PROFISSIONAL, NAO POR TENANT (D-171): quem ve o item e decidido
/// por `ownerProfessionalProfileId` + `visibility`, nao pelo tenant. O
/// `tenantId` e NULAVEL de proposito: NULL = item PLATFORM, global, visivel a
/// todos os tenants (D-089); preenchido = tenant do profissional dono, gravado
/// como rastro/defesa em profundidade (D-166 — ADR-0017). Por causa desse NULL,
/// Exercise NAO entra em TENANT_SCOPED_MODELS: a extension sobrescreve
/// `tenantId` incondicionalmente e apagaria a biblioteca global — ver
/// tenant-isolation-extension.ts.
///
/// `nameNormalized` e a chave da ANTI-DUPLICACAO NORMALIZADA (D-169): nome sem
/// acento, minusculo, com espaco/hifen colapsados. Coluna PERSISTIDA porque a
/// comparacao precisa acontecer no banco (o Prisma nao tem unaccent); a
/// normalizacao canonica vive na aplicacao (normalizeLibraryItemName), e esta
/// coluna e sempre derivada dela — nunca preenchida a mao.
model Exercise {
  id                         String            @id @default(cuid())
  tenantId                   String? // NULL = item PLATFORM global (D-089); preenchido = tenant do dono (D-166)
  ownerProfessionalProfileId String? // nulo = item da plataforma; preenchido = item do profissional
  specialtyId                String? // especialidade a que o exercicio pertence (estrutural)
  primaryMuscleGroupId       String // grupo muscular dominante — obrigatorio (D-164)
  name                       String
  nameNormalized             String // derivado de `name` para anti-duplicacao (D-169)
  description                String? // descricao/instrucao de execucao (D-089)
  videoStorageKey            String? // video demonstrativo: chave S3 (D-091; padrao de ProgressPhoto)
  visibility                 LibraryVisibility @default(PRIVATE) // itens do profissional privados por padrao
  status                     LibraryItemStatus @default(ACTIVE) // delecao logica (D-089)
  createdAt                  DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime          @updatedAt @db.Timestamptz(3)

  tenant                   Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerProfessionalProfile ProfessionalProfile? @relation(fields: [ownerProfessionalProfileId], references: [id], onDelete: Cascade)
  specialty                Specialty?           @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  primaryMuscleGroup       MuscleGroup          @relation("ExercisePrimaryMuscleGroup", fields: [primaryMuscleGroupId], references: [id], onDelete: Restrict)
  secondaryMuscleGroups    ExerciseSecondaryMuscleGroup[]
  workoutItems             WorkoutItem[]
  formAnalyses             FormAnalysis[]

  @@index([tenantId])
  @@index([ownerProfessionalProfileId])
  @@index([specialtyId])
  @@index([primaryMuscleGroupId]) // agrupar/filtrar por grupo dominante (D-164/D-092)
  @@index([visibility])
  @@index([status]) // busca so devolve ACTIVE (D-089)
  @@index([nameNormalized]) // anti-duplicacao normalizada na entrada (D-169)
  @@map("exercise")
}

/// PLANO de treino de um paciente, atado a um VINCULO (Bond — D-052). E o nivel
/// que faltava no esqueleto (D-079): o vinculo tem N PLANOS ATIVOS SIMULTANEOS
/// (ex.: "Musculacao Julho" + "Cardio Julho"), todos do mesmo profissional — por
/// isso NAO ha unique bloqueando plano ativo por vinculo.
///
/// Dono da organizacao (D-080), da validade (D-083) e do agendamento (D-084).
/// tenantId denormalizado para escopo (D-002); isolado por vinculo (ADR-0001).
/// Datas em UTC (D-067). Sincronizavel offline quando ACTIVE (D-099).
model WorkoutPlan {
  id           String            @id @default(cuid())
  tenantId     String // tenant do profissional (escopo denormalizado — D-002)
  bondId       String // vinculo dono do plano (isolamento por vinculo — ADR-0001)
  title        String
  organization PlanOrganization // A/B/C ou dias da semana — por plano (D-080)
  status       WorkoutPlanStatus @default(DRAFT)
  validityDays Int               @default(30) // validade padrao 30d, configuravel (D-083)
  validUntil   DateTime?         @db.Timestamptz(3) // vencimento calculado na liberacao (UTC — D-083)
  releaseAt    DateTime?         @db.Timestamptz(3) // liberacao programada (UTC — D-084); nulo = imediata
  goal         String? // objetivo capturado na montagem do plano (D-095)

  /// Linhagem da clonagem (D-090). DELIBERADAMENTE SEM RELATION: o plano de
  /// origem pertence a OUTRO vinculo, e uma relacao criaria um caminho de join
  /// que vazaria dado de outro paciente. E ponteiro de auditoria, nao rota de
  /// leitura — o isolamento por vinculo (ADR-0001) continua inegociavel.
  clonedFromWorkoutPlanId String?

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3) // tombstone: delecao logica (D-089) + pull do sync (D-099)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bond     Bond      @relation(fields: [bondId], references: [id], onDelete: Cascade)
  workouts Workout[]

  @@index([bondId, status]) // planos ativos do aluno
  @@index([tenantId])
  @@index([status, validUntil]) // regua de vencimento (worker — D-083)
  @@index([status, releaseAt]) // regua de liberacao agendada (worker — D-084)
  @@index([bondId, updatedAt]) // cursor de sync pull-since (D-099)
  @@map("workout_plan")
}

/// TREINO de um plano (D-079): o "A", o "B", ou o treino de terca. Filho de
/// WorkoutPlan. `label` vale quando o plano e LETTER; `weekday` quando e WEEKDAY
/// (D-080) — a coerencia entre plan.organization e o campo preenchido e
/// invariante de dominio, nao do banco.
///
/// tenantId/bondId denormalizados para escopo (D-002) e para o filtro de sync
/// sem join (D-099). Datas em UTC (D-067).
model Workout {
  id        String    @id @default(cuid())
  tenantId  String // escopo denormalizado (D-002)
  bondId    String // isolamento por vinculo (ADR-0001)
  planId    String // plano dono do treino (D-079)
  title     String
  label     String? // "A"/"B"/"C" quando o plano e LETTER (D-080)
  weekday   Weekday? // dia marcado quando o plano e WEEKDAY (D-080)
  position  Int       @default(0) // ordem estrutural dentro do plano
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3) // tombstone: delecao logica (D-089) + pull do sync (D-099)

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bond     Bond             @relation(fields: [bondId], references: [id], onDelete: Cascade)
  plan     WorkoutPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  items    WorkoutItem[]
  sessions WorkoutSession[]

  @@index([planId, position])
  @@index([bondId])
  @@index([tenantId])
  @@index([bondId, updatedAt]) // cursor de sync pull-since (D-099)
  @@map("workout")
}

/// Item de um treino: um exercicio prescrito + ordem. As SERIES sao filhas
/// (WorkoutSet — D-081), nunca um Json.
///
/// CONJUGADOS (D-082): itens com o mesmo `supersetGroup` (dentro do mesmo
/// treino) sao executados em sequencia sem descanso — bi-set/tri-set/circuito.
/// `supersetOrder` e a ordem DENTRO do grupo. As RODADAS de um circuito sao as
/// SERIES (WorkoutSet.position = indice da rodada), nunca um contador: um
/// `roundCount` forcaria rodadas identicas, violando o D-081. O tipo do grupo
/// (bi/tri/circuito) e derivado da contagem de itens — nao ha atributo de grupo,
/// por isso NAO existe entidade WorkoutBlock.
///
/// INVARIANTE DE DOMINIO (nao do banco): todos os itens de um mesmo
/// `supersetGroup` tem a mesma contagem de series. Grupo malformado = erro de
/// validacao na aplicacao.
///
/// tenantId denormalizado (D-166 — ADR-0009 + ADR-0017): o item ja era escopado
/// TRANSITIVAMENTE pelo `workoutId`, mas isso depende 100% de o app validar o
/// pai antes de ler. Com a coluna propria, a extension de isolamento injeta o
/// filtro sozinha (defesa em profundidade — o dev nao pode esquecer).
model WorkoutItem {
  id            String    @id @default(cuid())
  tenantId      String // escopo denormalizado (D-002/D-166)
  workoutId     String
  exerciseId    String? // exercicio da biblioteca (opcional; item livre permitido)
  position      Int       @default(0) // ordem estrutural dentro do treino
  supersetGroup Int? // itens com o mesmo valor sao conjugados (D-082); nulo = isolado
  supersetOrder Int? // ordem dentro do grupo conjugado (D-082)
  note          String? // observacao do profissional sobre o item
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt     DateTime? @db.Timestamptz(3) // tombstone: delecao logica (D-089) + pull do sync (D-099)

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workout  Workout      @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise?    @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  sets     WorkoutSet[]

  @@index([workoutId, position])
  @@index([workoutId, supersetGroup, supersetOrder]) // montagem/execucao do conjugado
  @@index([exerciseId])
  @@index([tenantId])
  @@map("workout_item")
}

/// SERIE — o coracao do D-081: CADA SERIE E UMA LINHA PROPRIA, com seus proprios
/// valores. Um exercicio pode ter series totalmente diferentes entre si (serie 1
/// com 12 reps a 20kg; serie 3 ate a falha a 25kg em drop-set). Modelar como
/// "3x12 a 20kg" (uniforme) e PROIBIDO — requisito explicito do ADR-0009.
///
/// CARGA EM COLUNAS TIPADAS SEPARADAS, nunca par polimorfico `valor + unidade`:
/// o D-092 exige "evolucao de carga por exercicio", e com valor polimorfico uma
/// agregacao mal escrita somaria gramas com segundos — bug SILENCIOSO. Colunas
/// tipadas tornam o estado invalido irrepresentavel. O caso e real: o D-079 cita
/// "Cardio Julho" convivendo com musculacao, entao serie de tempo/distancia
/// convive com carga.
///
/// TUDO INTEIRO (gramas, segundos, metros) — nunca float; formatacao so na
/// exibicao, mesma disciplina do dinheiro em centavos (D-069).
///
/// `position` = ordem da serie no exercicio E, num grupo conjugado, o indice da
/// RODADA (D-082).
///
/// tenantId denormalizado (D-166) — mesmo racional do WorkoutItem: escopo que a
/// extension injeta, em vez de depender do app validar o pai.
model WorkoutSet {
  id            String @id @default(cuid())
  tenantId      String // escopo denormalizado (D-002/D-166)
  workoutItemId String
  position      Int // ordem da serie; num conjugado, e o indice da rodada (D-082)

  // Repeticoes — "ate a falha" e estado proprio, nao um valor magico em `reps`.
  reps          Int? // repeticoes prescritas; nulo quando repsToFailure
  repsToFailure Boolean @default(false) // "ate a falha" (D-081)

  // Carga — colunas tipadas, inteiras, mutuamente coerentes por invariante de
  // dominio (uma serie usa a grandeza do seu exercicio).
  weightGrams     Int? // carga em GRAMAS (ex.: 22500 = 22,5kg) — nunca float
  durationSeconds Int? // series por tempo (prancha, cardio)
  distanceMeters  Int? // series por distancia (corrida, remo)
  bodyweight      Boolean @default(false) // peso corporal: sem carga externa

  restSeconds Int? // descanso apos a serie; num conjugado, zero ate o ultimo item (D-082)
  technique   SetTechnique @default(NORMAL) // codigo; label no i18n (D-066)
  note        String?

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3) // tombstone: delecao logica (D-089) + pull do sync (D-099)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workoutItem WorkoutItem @relation(fields: [workoutItemId], references: [id], onDelete: Cascade)
  setLogs     SetLog[]

  @@unique([workoutItemId, position]) // nao ha duas series na mesma ordem
  @@index([workoutItemId])
  @@index([tenantId])
  @@map("workout_set")
}

// --- Treino: execucao (D-086 a D-088 — ADR-0009) ---------------------------
// ESCRITA OFFLINE-FIRST (D-099): estas tabelas sao o alvo principal do sync. O
// aluno registra a serie na academia, com ou sem sinal; o device e a fonte da
// verdade e o servidor reconcilia. Por isso: colunas TIPADAS (merge por campo e
// impossivel sobre Json), `deletedAt` (tombstone do pull) e `updatedAt`
// indexado (cursor pull-since).
// ---------------------------------------------------------------------------

/// SESSAO = uma execucao de um treino pelo aluno (D-086). Concluir a sessao
/// (COMPLETED) e obrigatorio e TAMBEM conta como CHECK-IN do aluno no app,
/// alimentando os indicadores (D-092).
///
/// `performedAt` e indexado por vinculo: e a base da aderencia, do streak e do
/// volume semanal (D-092), e o eixo do particionamento por data quando o
/// historico crescer (D-100). Historico NUNCA e deletado (guarda legal — D-100).
/// planId denormalizado evita join na linha do tempo. Datas em UTC (D-067).
model WorkoutSession {
  id          String               @id @default(cuid())
  tenantId    String // escopo denormalizado (D-002)
  bondId      String // isolamento por vinculo (ADR-0001)
  workoutId   String
  planId      String // denormalizado: linha do tempo sem join (D-092)
  status      WorkoutSessionStatus @default(IN_PROGRESS)
  performedAt DateTime             @db.Timestamptz(3) // quando o treino foi executado (UTC) — eixo dos indicadores
  completedAt DateTime?            @db.Timestamptz(3) // conclusao = check-in (D-086)
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime?            @db.Timestamptz(3) // tombstone do sync (D-099); historico nao se apaga (D-100)

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bond    Bond           @relation(fields: [bondId], references: [id], onDelete: Cascade)
  workout Workout        @relation(fields: [workoutId], references: [id], onDelete: Restrict)
  setLogs SetLog[]
  rating  WorkoutRating?

  @@index([bondId, performedAt]) // aderencia, streak, volume semanal (D-092)
  @@index([workoutId])
  @@index([tenantId, performedAt]) // aderencia agregada do profissional (D-092)
  @@index([bondId, status]) // execucoes pendentes no escopo de sync (D-099)
  @@index([bondId, updatedAt]) // cursor de sync pull-since (D-099)
  @@map("workout_session")
}

/// REGISTRO DA SERIE EXECUTADA (D-086): a CARGA REAL usada, que pode divergir da
/// prescrita — e o dado real que importa para a evolucao (D-085/D-092). Espelha
/// as grandezas tipadas de WorkoutSet, pelo mesmo motivo (agregacao segura).
///
/// `workoutSetId` e opcional: o aluno pode executar uma serie extra que nao
/// estava prescrita. onDelete Restrict porque a prescricao nunca e apagada
/// fisicamente (D-089).
///
/// tenantId denormalizado (D-166) — mesmo racional do WorkoutItem/WorkoutSet.
model SetLog {
  id           String  @id @default(cuid())
  tenantId     String // escopo denormalizado (D-002/D-166)
  sessionId    String
  workoutSetId String? // serie prescrita de referencia; nulo = serie livre do aluno

  done       Boolean @default(false)
  actualReps Int? // repeticoes realmente feitas

  // Carga REAL — mesmas colunas tipadas inteiras da prescricao (D-081).
  actualWeightGrams     Int?
  actualDurationSeconds Int?
  actualDistanceMeters  Int?

  note String?

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3) // tombstone do sync (D-099)

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session    WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  workoutSet WorkoutSet?    @relation(fields: [workoutSetId], references: [id], onDelete: Restrict)

  @@index([sessionId])
  @@index([workoutSetId]) // evolucao de carga por exercicio (D-092)
  @@index([tenantId])
  @@map("set_log")
}

/// AVALIACAO DO TREINO (D-087) — obrigatoria ao concluir (D-086) e UMA POR
/// SESSAO (@unique sessionId). Projetada para ser printada e compartilhada
/// (aquisicao organica): nota, esforco percebido, comentario livre e REACOES
/// rapidas.
///
/// `reactions` guarda CODIGOS (D-066): o label e o emoji ("morri 💀") vivem no
/// i18n — trocar a redacao e traducao, nao migracao. O "instagramavel" e da UI;
/// aqui so o dado.
///
/// Avaliacao muito dificil/facil e sinal de ajuste para o profissional (D-092).
///
/// tenantId denormalizado (D-166) — mesmo racional dos demais filhos de treino.
model WorkoutRating {
  id              String            @id @default(cuid())
  tenantId        String // escopo denormalizado (D-002/D-166)
  sessionId       String            @unique // uma avaliacao por sessao executada (D-087)
  score           Int // nota 1 a 5 (D-087)
  perceivedEffort Int // nivel de esforco percebido (D-087)
  comment         String? // comentario livre (D-087)
  reactions       WorkoutReaction[] // codigos; label/emoji no i18n (D-066)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime?         @db.Timestamptz(3) // tombstone do sync (D-099)

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([score]) // alunos avaliando como muito dificil/facil (D-092)
  @@index([tenantId])
  @@map("workout_rating")
}

/// ANALISE DE FORMA POR IA (D-088) — ASSINCRONA e com HUMANO NO CIRCUITO. O
/// aluno grava um video; a IA pre-analisa (pose estimation) e sugere pontos de
/// atencao; o PROFISSIONAL VALIDA antes de qualquer devolutiva ao aluno. NAO e
/// analise ao vivo por camera.
///
/// Regra de aplicacao inegociavel: nada chega ao aluno enquanto
/// reviewStatus != APPROVED. Captura markerless por camera unica nao e
/// grau-laboratorio, e o profissional e o responsavel tecnico — IA dando
/// devolutiva direta a leigo e risco de lesao e de responsabilidade civil
/// (D-023/D-088).
///
/// `aiResult Json?` e Json LEGITIMO: e o payload BRUTO do provider de pose
/// estimation (formato externo, semiestruturado), nao conteudo de dominio. A
/// regra de matar o Json (D-063/ADR-0009) vale para o dominio, nao para a
/// resposta crua de terceiro. Fora do escopo de sync offline (D-099).
model FormAnalysis {
  id         String  @id @default(cuid())
  tenantId   String // escopo denormalizado (D-002)
  bondId     String // isolamento por vinculo (ADR-0001) — e dado clinico
  exerciseId String? // exercicio analisado (biblioteca)
  sessionId  String? // sessao em que ocorreu, quando houver

  videoStorageKey String // video da execucao: chave S3 (o binario nunca vive aqui)

  aiStatus FormAnalysisAiStatus @default(PENDING)
  aiResult Json? // payload BRUTO do provider (Json legitimo — ver doc acima)

  reviewStatus                  FormAnalysisReviewStatus @default(PENDING)
  reviewedByProfessionalProfile String? // profissional que validou (D-088)
  professionalFeedback          String? // devolutiva do profissional ao aluno
  reviewedAt                    DateTime?                @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3) // delecao logica (D-089)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bond     Bond      @relation(fields: [bondId], references: [id], onDelete: Cascade)
  exercise Exercise? @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@index([bondId])
  @@index([tenantId])
  @@index([reviewStatus]) // fila de validacao do profissional (D-088)
  @@index([aiStatus]) // fila de pre-analise (worker)
  @@map("form_analysis")
}

// --- Nutricao (D-112 a D-121 + emendas D-114/D-117 — ADR-0013) -------------
// O D-063 FECHA para nutricao (ADR-0009 fechou treino; ADR-0011 fechou anamnese).
// A hierarquia ganha o nivel que faltava — MealPlan -> Meal -> MealPlanItem
// (D-112) — que DESTRAVA o D-104/D-118. A nutricao vira COLUNA TIPADA: a parte
// nutricional do `detail Json?` do Food morre (colunas kcal/macros por medida de
// referencia); `MealPlan.detail` e `MealPlanItem.detail` morrem por inteiro (a
// taxonomia existe agora e o merge por campo do offline-first — D-099 — e
// impossivel sobre Json). Ver docs/adr/0013-dominio-nutricao.md, "Impacto de
// modelagem".
//
// FORA deste slice (aditivos, migracao separada): MealPlanImport (D-133) e
// MealSuggestion (D-134). Medidas caseiras, hidratacao, receitas e gasto
// energetico seguem gaps conhecidos — NAO modelar sem ADR proprio.
// ---------------------------------------------------------------------------

/// Origem/tabela nutricional de um alimento (D-117 emenda — ADR-0013). E COLUNA,
/// nao convencao: a origem e o que IMPEDE o calculo de misturar fontes em
/// silencio. Fecha o gap "tabelas alem da TACO". A trava do D-117 e expressavel
/// POR ESTA COLUNA: a busca de MONTAGEM (profissional) filtra OPEN_FOOD_FACTS
/// fora (base colaborativa, ruidosa); a de REGISTRO (paciente) inclui — sem flag
/// paralela. Label exibido no i18n (D-066).
enum FoodSource {
  TACO // tabela oficial brasileira (referencia de medidas — D-114)
  TBCA // Tabela Brasileira de Composicao de Alimentos
  OPEN_FOOD_FACTS // base aberta/colaborativa; so na busca de registro (D-117)
  PROFESSIONAL_CUSTOM // alimento/preparacao proprio do profissional (D-064/D-117)
}

/// Ancora da normalizacao calorica automatica (D-114 emenda — ADR-0013). Ao
/// substituir um item, o sistema recalcula a quantidade do substituto para
/// preservar o alvo NESTE nutriente (nutricao esportiva as vezes ancora em
/// proteina, nao em kcal). E CAMPO, nao hardcode: vive no MealPlan (default) com
/// override OPCIONAL na Meal — nao desce ao item (o alvo e do plano/refeicao;
/// seria overengineering). A normalizacao em si e DERIVACAO em runtime, nunca
/// armazenada — so congela no MealLog (D-118).
enum NormalizationAnchor {
  CALORIES
  PROTEIN
  CARB
  FAT
}

/// Momento do dia de uma refeicao (D-113 — ADR-0013). Catalogo FIXO da
/// plataforma, de perfil ESPORTIVO: pre e pos-treino sao momentos de PRIMEIRA
/// CLASSE, nao observacao apelidada. Guarda o CODIGO; o rotulo vive no i18n
/// (D-066), mesma disciplina de Weekday/SetTechnique.
enum MealMoment {
  CAFE_DA_MANHA
  LANCHE_DA_MANHA
  ALMOCO
  LANCHE_DA_TARDE
  PRE_TREINO
  POS_TREINO
  JANTAR
  CEIA
}

/// Resposta do registro de refeicao (D-118 — ADR-0013, revisa o D-104). TRES
/// estados, nao binario: "parcial" e a resposta honesta mais comum e colapsa-la
/// em sim/nao destruiria o indicador de aderencia. Guarda o CODIGO; rotulo no
/// i18n (D-066).
enum MealLogStatus {
  ATE_ALL // comi tudo
  PARTIAL // comi parcial
  SKIPPED // nao comi
}

/// Item da biblioteca de alimentos (D-063/D-089/D-117 — ADR-0013). Base da
/// plataforma (PLATFORM, sem dono) OU item do profissional (PRIVATE por padrao),
/// mesmo modelo do Exercise. Delecao SEMPRE LOGICA (`status` — D-089).
///
/// NUTRICAO TIPADA POR MEDIDA DE REFERENCIA (D-114 emenda): as colunas
/// energyKcal/proteinMg/carbMg/fatMg guardam o valor nutricional POR
/// `referencePortionGrams` — sem isso a normalizacao (D-114) e impossivel. Tudo
/// INTEIRO (D-069, mesma disciplina dos gramas do treino): energia em kcal,
/// macros em MILIGRAMAS (preserva 0,1g sem float). NULAVEIS de proposito:
/// produtos do Open Food Facts tem macros incompletos (D-117) — congela o que
/// existe, marca a lacuna, NUNCA inventa. `referencePortionGrams` default 100 = a
/// base per-100g da TACO (D-114), sempre explicita para que o valor tenha sentido.
///
/// `source` (FoodSource) e a ORIGEM como coluna (D-117 emenda) — nao misturar
/// tabelas em silencio. `barcode` (GTIN/EAN, indexado) e `externalRef` (id na
/// fonte externa) suportam o scan do registro (D-118) e a materializacao de um
/// produto do OFF como Food no primeiro scan.
///
/// `detail Json?` ENCOLHEU: a nutricao saiu para colunas; resta so o detalhe fino
/// AINDA nao modelado (fibra, sodio, micronutrientes, preparacao) — deferido, nao
/// inventar.
model Food {
  id                         String            @id @default(cuid())
  ownerProfessionalProfileId String? // nulo = item da plataforma; preenchido = item do profissional
  specialtyId                String? // especialidade (ex.: NUTRITION) — estrutural
  name                       String
  source                     FoodSource // origem/tabela — coluna, nao convencao (D-117)
  barcode                    String? // GTIN/EAN (industrializado); a maioria da TACO nao tem (D-117)
  externalRef                String? // id do produto na fonte externa (ex.: OFF) (D-117)
  referencePortionGrams      Int               @default(100) // base da nutricao, em gramas (TACO per-100g — D-114)
  energyKcal                 Int? // energia por porcao de referencia (kcal inteiro); nulo = lacuna (D-117)
  proteinMg                  Int? // proteina por porcao de referencia (miligramas); nulo = lacuna (D-117)
  carbMg                     Int? // carboidrato por porcao de referencia (miligramas); nulo = lacuna (D-117)
  fatMg                      Int? // gordura por porcao de referencia (miligramas); nulo = lacuna (D-117)
  visibility                 LibraryVisibility @default(PRIVATE)
  status                     LibraryItemStatus @default(ACTIVE) // delecao logica — regra geral (D-089)
  detail                     Json? // detalhe fino AINDA nao modelado (fibra/sodio/micros/preparacao) — nao inventar
  createdAt                  DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime          @updatedAt @db.Timestamptz(3)

  ownerProfessionalProfile ProfessionalProfile? @relation(fields: [ownerProfessionalProfileId], references: [id], onDelete: Cascade)
  specialty                Specialty?           @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  mealPlanItems            MealPlanItem[]
  foodGroupMembers         FoodGroupMember[]
  mealLogItems             MealLogItem[]

  @@index([ownerProfessionalProfileId])
  @@index([specialtyId])
  @@index([visibility])
  @@index([status]) // busca so devolve ACTIVE (D-089)
  @@index([source]) // trava de escopo: montagem filtra OFF fora, registro inclui (D-117)
  @@index([barcode]) // lookup do scan de codigo de barras no registro (D-118)
  @@map("food")
}

/// Grupo alimentar com equivalencia nutricional (D-114 — ADR-0013). E o achado
/// central da pesquisa: a substituicao NAO e troca ad hoc item a item — e por
/// GRUPO com equivalencia (o grupo "proteina" reune frango, tilapia, ovo, cada um
/// com sua porcao equivalente). Food sozinho nao expressa isso.
///
/// Mesmo modelo de biblioteca do Food (D-117 "reafirma D-064"): base da
/// plataforma (PLATFORM, sem dono) OU grupo proprio do profissional (PRIVATE por
/// padrao). Delecao SEMPRE LOGICA (`status`) — vale para alimento E grupo (D-089).
///
/// A media calorica/nutricional do grupo (D-114) NAO e armazenada: e DERIVADA em
/// runtime dos membros (FoodGroupMember + a nutricao do Food). Congela-la
/// violaria "nada de valor normalizado armazenado fora do MealLog".
model FoodGroup {
  id                         String            @id @default(cuid())
  ownerProfessionalProfileId String? // nulo = grupo da plataforma; preenchido = grupo do profissional
  specialtyId                String? // especialidade (ex.: NUTRITION) — estrutural
  name                       String
  visibility                 LibraryVisibility @default(PRIVATE)
  status                     LibraryItemStatus @default(ACTIVE) // delecao logica — vale para grupo (D-089)
  createdAt                  DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime          @updatedAt @db.Timestamptz(3)

  ownerProfessionalProfile ProfessionalProfile? @relation(fields: [ownerProfessionalProfileId], references: [id], onDelete: Cascade)
  specialty                Specialty?           @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  members                  FoodGroupMember[]
  mealPlanItems            MealPlanItem[]

  @@index([ownerProfessionalProfileId])
  @@index([specialtyId])
  @@index([visibility])
  @@index([status]) // busca so devolve ACTIVE (D-089)
  @@map("food_group")
}

/// Membro de um grupo alimentar (D-114 emenda — ADR-0013). NAO e M:N nua: cada
/// membro carrega sua PORCAO DE REFERENCIA — os gramas DESTE alimento que
/// constituem UMA porcao-padrao do grupo (no grupo "proteina", 1 porcao = 100g de
/// frango OU 120g de tilapia, caloricamente equivalentes). Sem a porcao por membro
/// a equivalencia nao se calcula — por isso `referencePortionGrams` e COLUNA
/// NAO-NULA: membro sem porcao e estado IRREPRESENTAVEL (construir > validar).
///
/// A nutricao vem do Food referenciado (por Food.referencePortionGrams); o membro
/// so diz QUANTOS GRAMAS = 1 porcao do grupo. A media do grupo e derivada disso em
/// runtime, nunca armazenada.
model FoodGroupMember {
  id                    String   @id @default(cuid())
  foodGroupId           String
  foodId                String
  referencePortionGrams Int // gramas deste alimento = 1 porcao-padrao do grupo (nao-nulo: equivalencia sempre calculavel)
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)

  foodGroup FoodGroup @relation(fields: [foodGroupId], references: [id], onDelete: Cascade)
  food      Food      @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@unique([foodGroupId, foodId]) // um alimento aparece uma vez por grupo
  @@index([foodId])
  @@map("food_group_member")
}

/// Plano alimentar de um paciente, atado a um VINCULO (Bond). tenantId
/// denormalizado para escopo (D-002). Ganha `normalizationAnchor` (D-114 emenda):
/// a ancora default da normalizacao de substituicoes do plano; a Meal pode dar
/// override. O `detail Json?` MORREU (a taxonomia existe agora; item 3 do ADR).
/// A hierarquia agora vai a Meal, nao direto ao item (D-112). Datas em UTC (D-067).
model MealPlan {
  id                  String              @id @default(cuid())
  tenantId            String // escopo denormalizado (D-002)
  bondId              String // isolamento por vinculo (ADR-0001)
  title               String
  normalizationAnchor NormalizationAnchor @default(CALORIES) // ancora default das substituicoes (D-114)
  createdAt           DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bond   Bond   @relation(fields: [bondId], references: [id], onDelete: Cascade)
  meals  Meal[]

  @@index([bondId])
  @@index([tenantId])
  @@map("meal_plan")
}

/// Refeicao = momento do dia dentro de um plano (D-112/D-113 — ADR-0013). E o
/// nivel que FALTAVA no esqueleto (MealPlan ia direto ao item) e que DESTRAVA o
/// D-104/D-118 — nao havia a que atar "marquei que comi". Mesma lacuna que o D-079
/// achou no treino.
///
/// D-115 (calculado x texto livre): a refeicao aceita ITENS calculados OU
/// `freeText` de orientacao ("almoco: proteina + salada a vontade") — sem que "sem
/// itens" e "orientacao livre" colapsem no mesmo estado (o freeText os distingue).
///
/// `anchorOverride`: override OPCIONAL da ancora do plano (D-114 emenda) — nutricao
/// esportiva as vezes ancora UMA refeicao em proteina. null = herda o MealPlan.
model Meal {
  id             String               @id @default(cuid())
  mealPlanId     String
  moment         MealMoment // momento do dia (catalogo fixo — D-113)
  freeText       String? // orientacao livre (D-115); null = refeicao calculada por itens
  anchorOverride NormalizationAnchor? // override da ancora do plano (D-114); null = herda
  position       Int                  @default(0) // ordem estrutural dentro do plano
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(3)

  mealPlan MealPlan       @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  items    MealPlanItem[]
  logs     MealLog[]

  @@index([mealPlanId, position])
  @@map("meal")
}

/// Item de uma refeicao (D-114/D-115 — ADR-0013). TRES modos mutuamente
/// exclusivos, sem colapsar num so estado:
///  - ALIMENTO: `foodId` + `quantityGrams` (ex.: 150g de frango).
///  - GRUPO: `foodGroupId` + `portionQuantity` (ex.: 1 porcao do grupo proteina —
///    o frango e UMA das opcoes equivalentes, D-114). A quantidade normalizada do
///    substituto e DERIVADA em runtime (D-114 emenda), nunca armazenada aqui.
///  - TEXTO LIVRE: `freeText` (ex.: "cafe sem acucar") — item fora da base (D-115),
///    distinto da orientacao da refeicao inteira (Meal.freeText).
///
/// O XOR entre os tres modos e INVARIANTE DE DOMINIO (aplicacao/Zod), nao do banco
/// — mesma disciplina do WorkoutItem (item livre) e do supersetGroup. Porcao
/// fracionaria (1/2) NAO e modelada (quantidades inteiras — gramas e porcoes); e
/// limitacao declarada, na familia do gap de "medidas caseiras" (ADR-0013).
///
/// `detail Json?` MORREU aqui (a taxonomia existe agora): o merge por campo do
/// offline-first (D-099) e impossivel sobre Json.
model MealPlanItem {
  id              String   @id @default(cuid())
  mealId          String
  foodId          String? // modo ALIMENTO (biblioteca); nulo nos outros modos
  foodGroupId     String? // modo GRUPO (equivalencia — D-114); nulo nos outros modos
  freeText        String? // modo TEXTO LIVRE (D-115); nulo nos modos calculados
  quantityGrams   Int? // gramas do alimento (modo ALIMENTO) — inteiro, nunca float
  portionQuantity Int? // n de porcoes-padrao do grupo (modo GRUPO) — inteiro
  position        Int      @default(0) // ordem estrutural dentro da refeicao
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  meal      Meal       @relation(fields: [mealId], references: [id], onDelete: Cascade)
  food      Food?      @relation(fields: [foodId], references: [id], onDelete: SetNull)
  foodGroup FoodGroup? @relation(fields: [foodGroupId], references: [id], onDelete: SetNull)

  @@index([mealId, position])
  @@index([foodId])
  @@index([foodGroupId])
  @@map("meal_plan_item")
}

/// Registro de refeicao pelo paciente (D-118 — ADR-0013, revisa o D-104). O
/// paciente marca comi tudo / parcial / nao comi (MealLogStatus) — tres estados,
/// porque "parcial" e a resposta honesta mais comum e o binario destruiria a
/// aderencia. Conta como CHECK-IN (igual ao treino — D-086) e alimenta o indicador
/// de aderencia (D-120).
///
/// ESCRITA OFFLINE-FIRST (D-099/D-118): o paciente registra com ou sem sinal; o
/// device e a fonte e o servidor reconcilia. Por isso tenantId+bondId
/// denormalizados (escopo — D-002/ADR-0001), `deletedAt` (tombstone do pull) e
/// `updatedAt` indexado (cursor pull-since), espelhando WorkoutSession. Historico
/// nao se apaga (guarda legal — D-100), por isso `meal` e onDelete Restrict.
///
/// O SNAPSHOT nutricional congelado vive nos filhos (MealLogItem): o que foi
/// comido naquele momento nao muda se a tabela de origem for corrigida depois
/// (D-114 emenda — "mesmo principio do preco na compra").
model MealLog {
  id              String        @id @default(cuid())
  tenantId        String // escopo denormalizado (D-002)
  bondId          String // isolamento por vinculo (ADR-0001) — e dado clinico
  mealId          String // refeicao registrada (do plano)
  status          MealLogStatus // comi tudo / parcial / nao comi (D-118)
  comment         String? // comentario opcional (D-118)
  photoStorageKey String? // foto opcional: chave S3 (o binario nunca vive aqui) (D-118)
  loggedAt        DateTime      @db.Timestamptz(3) // quando a refeicao foi consumida (UTC) — eixo da aderencia
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime?     @db.Timestamptz(3) // tombstone do sync (D-099); historico nao se apaga (D-100)

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bond   Bond          @relation(fields: [bondId], references: [id], onDelete: Cascade)
  meal   Meal          @relation(fields: [mealId], references: [id], onDelete: Restrict)
  items  MealLogItem[]

  @@index([bondId, loggedAt]) // aderencia/streak do paciente (D-120)
  @@index([tenantId, loggedAt]) // aderencia agregada do profissional (D-120)
  @@index([mealId])
  @@index([bondId, updatedAt]) // cursor de sync pull-since (D-099)
  @@map("meal_log")
}

/// Item congelado de um registro de refeicao (D-114/D-117 emendas / D-118 —
/// ADR-0013). E o SNAPSHOT: a nutricao do que foi comido NAQUELE momento,
/// DENORMALIZADA (colunas frozen*), nao FK viva para Food. Se a tabela de origem
/// for corrigida depois, o que o paciente comeu nao muda — "mesmo principio do
/// preco na compra". E o UNICO lugar onde valor normalizado e ARMAZENADO (fora
/// dele, normalizacao e sempre derivacao em runtime).
///
/// `foodId` e referencia OPCIONAL de proveniencia (que alimento originou), com
/// onDelete SetNull — a proveniencia pode sumir, o snapshot permanece. Produto
/// escaneado por codigo de barras (D-117) que ainda nao virou Food fica so nas
/// colunas frozen + `barcode`.
///
/// LACUNA EXPLICITA (D-117 emenda): item do OFF logado com macros incompletos
/// congela o que existe (frozen* nulo onde falta) e marca `hasNutritionGap` —
/// nunca inventa. Preferir a lacuna explicita ao dado falso. Unidades iguais as do
/// Food (kcal + mg); tudo inteiro (D-069).
model MealLogItem {
  id               String    @id @default(cuid())
  mealLogId        String
  foodId           String? // proveniencia opcional (D-117); nulo p/ escaneado-sem-Food ou texto livre
  barcode          String? // GTIN/EAN escaneado no registro (D-117), quando houver
  label            String // nome congelado do que foi comido (a origem pode mudar/sumir)
  quantityGrams    Int? // quantidade consumida, em gramas — inteiro, nunca float
  frozenEnergyKcal Int? // energia congelada da quantidade consumida; nulo = lacuna (D-117)
  frozenProteinMg  Int? // proteina congelada (miligramas); nulo = lacuna (D-117)
  frozenCarbMg     Int? // carboidrato congelado (miligramas); nulo = lacuna (D-117)
  frozenFatMg      Int? // gordura congelada (miligramas); nulo = lacuna (D-117)
  hasNutritionGap  Boolean   @default(false) // macro ausente no congelamento (D-117) — lacuna explicita
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime? @db.Timestamptz(3) // tombstone do sync (D-099)

  mealLog MealLog @relation(fields: [mealLogId], references: [id], onDelete: Cascade)
  food    Food?   @relation(fields: [foodId], references: [id], onDelete: SetNull)

  @@index([mealLogId])
  @@index([foodId])
  @@map("meal_log_item")
}

// --- Medico ----------------------------------------------------------------

/// Atendimento medico, atado a um VINCULO (Bond). Apenas estrutural: escopo +
/// vinculo + quando ocorreu. Conteudo clinico deferido para `detail Json?`
/// (TODO D-063). Isolado por vinculo (ADR-0001). Datas em UTC (D-067).
model Encounter {
  id       String @id @default(cuid())
  tenantId String // escopo denormalizado (D-002)
  bondId   String // isolamento por vinculo (ADR-0001)

  /// O agendamento que originou este atendimento (ADR-0012). OPCIONAL de
  /// proposito: o D-018/D-109 querem tudo passando pelo app, mas nao podem
  /// impedir o mundo real — a consulta pode ocorrer sem ter sido marcada aqui.
  appointmentId String? @unique

  occurredAt DateTime? @db.Timestamptz(3) // quando o atendimento ocorreu (estrutural; UTC)
  detail     Json? // TODO(D-063): conteudo clinico por fase — nao inventar
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bond          Bond           @relation(fields: [bondId], references: [id], onDelete: Cascade)
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  prescriptions Prescription[]

  @@index([bondId])
  @@index([tenantId])
  @@map("encounter")
}

/// Prontuario, atado a um VINCULO (Bond) — um por vinculo (@unique bondId): o
/// container acumula o historico; as entradas finas sao deferidas para
/// `detail Json?` (TODO D-063). Nenhum campo clinico modelado aqui. Isolado por
/// vinculo (ADR-0001). Datas em UTC (D-067).
model MedicalRecord {
  id        String   @id @default(cuid())
  tenantId  String // escopo denormalizado (D-002)
  bondId    String   @unique // um prontuario por vinculo (isolamento — ADR-0001)
  detail    Json? // TODO(D-063): entradas do prontuario por fase — nao inventar
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bond   Bond   @relation(fields: [bondId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("medical_record")
}

/// Folha de receita — estrutural apenas: pertence a um atendimento (Encounter).
/// SEM PRESCRICAO ELETRONICA NO MVP — ADR-0003: nenhum campo de medicamento nem
/// estrutura clinica de prescricao aqui; o conteudo e deferido para `detail Json?`
/// (TODO D-063). tenantId denormalizado para escopo (D-002). Datas em UTC (D-067).
model Prescription {
  id          String   @id @default(cuid())
  tenantId    String // escopo denormalizado (D-002)
  encounterId String // atendimento dono da folha de receita
  detail      Json? // TODO(D-063): conteudo da receita por fase — nao inventar
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId])
  @@index([tenantId])
  @@map("prescription")
}

// --- Transversal (isolado por vinculo — ADR-0001) --------------------------

/// ANAMNESE — o GATE do fluxo de entrada (D-093/D-094 — ADR-0010). Separada de
/// Assessment de proposito: sao ciclos de vida diferentes. A anamnese e UMA POR
/// VINCULO (@unique bondId) e e documento que o profissional anexa ao prontuario;
/// a avaliacao/medidas (Assessment) e RECORRENTE.
///
/// "Uma por profissional" (D-094) = uma por VINCULO, porque o vinculo ja
/// encapsula (paciente + profissional + especialidade). NUNCA compartilhada
/// automaticamente: cruzar para outro profissional exige consentimento explicito
/// do paciente (D-016/ADR-0003).
///
/// GATE (D-093): enquanto status != ANSWERED, o profissional nao monta o plano e
/// o aluno ve o que precisa fazer. A fonte da verdade do gate e ESTE registro —
/// nao ha flag duplicada no Bond, que poderia divergir.
///
/// CAMPOS TIPADOS (D-103, ADR-0011): o `detail Json?` MORREU. Esta entidade e o
/// CONTAINER + o gate; o conteudo vive nas SECOES (nucleo + modulo por
/// especialidade), cada uma com autoria propria (D-102). Secao ausente = linha
/// ausente — nao ha campo nulo representando "nao perguntado".
///
/// O ADR-0011 REVISA o D-094: a anamnese pode ser preenchida pelo paciente, pelo
/// profissional ou por AMBOS, e pode NASCER do profissional na consulta
/// presencial (D-102) — o gate e satisfeito independente de quem preencheu. A
/// modalidade do vinculo (D-101) e que define o fluxo.
model Anamnesis {
  id         String          @id @default(cuid())
  tenantId   String // escopo denormalizado (D-002)
  bondId     String          @unique // uma por vinculo (D-094); isolamento (ADR-0001)
  status     AnamnesisStatus @default(PENDING) // o GATE (D-093)
  answeredAt DateTime?       @db.Timestamptz(3) // quando a anamnese foi dada por respondida (UTC)
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bond   Bond   @relation(fields: [bondId], references: [id], onDelete: Cascade)

  // Secoes (D-103). Cada uma e OPCIONAL: secao ausente = linha ausente.
  parq             AnamnesisParq?
  goal             AnamnesisGoal?
  clinicalHistory  AnamnesisClinicalHistory?
  familyHistory    AnamnesisFamilyHistory?
  lifestyle        AnamnesisLifestyle?
  emergencyContact AnamnesisEmergencyContact?
  training         AnamnesisTraining?

  @@index([tenantId])
  @@index([status]) // alunos com gate aberto/fechado
  @@map("anamnesis")
}

// --- Secoes da anamnese (D-102/D-103 — ADR-0011) -----------------------------
//
// A SECAO E ENTIDADE, nao agrupamento visual — a autoria (D-102) e que decide a
// forma. Cada secao carrega o proprio autor + timestamp, COLOCADOS COM O DADO:
// e impossivel existir dado sem autor. Uma tabela de autoria separada deixaria o
// estado invalido representavel (dado orfao de autor), o mesmo defeito que
// rejeitou a flag de gate no Bond (D-093) e a carga polimorfica (D-081).
//
// TRES PROPRIEDADES QUE A FORMA COMPRA:
// 1. Autoria colocada na secao -> dado sem autor e irrepresentavel.
// 2. SECAO AUSENTE = LINHA AUSENTE -> resolve "nao respondido" != "respondido
//    como nao" no nivel do BLOCO, sem coluna de controle.
// 3. CONDICIONAL = boolean explicito + filhas -> resolve no nivel do CAMPO:
//    `takesMedication: false` -> zero linhas de medicamento; `null` -> nao
//    perguntado. Ninguem responde tudo (D-103): saudavel responde ~15 perguntas
//    em ~3min, complexo responde 40 porque precisa.
//
// ESCOPO DESTE PR: nucleo + modulo TREINO. Os modulos de nutricao e nutrologia
// vem depois — nutrologia depende de exames laboratoriais (D-076) que nao
// existem, e nutricao pertence ao dominio do D-063 (aguarda Dietbox). O GATE
// funciona para TODAS as especialidades so com o nucleo, entao nada trava.
//
// ANTROPOMETRIA NAO MORA AQUI (ADR-0011): adipometria/bioimpedancia sao bloco
// VISIVEL NO FLUXO da anamnese, mas o DADO vive no Assessment — medida e
// recorrente por natureza, e a "primeira medida" e so o primeiro Assessment. O
// FLUXO da anamnese NAO e 1:1 com esta entidade: um passo do fluxo escreve em
// outra tabela. Colocar campos de medida aqui criaria a mesma medida em dois
// lugares, divergindo na segunda consulta.
//
// Textos das perguntas vivem no i18n (D-066), nunca no schema.
// -----------------------------------------------------------------------------

/// PAR-Q — Questionario de Prontidao para Atividade Fisica (D-103). Padrao
/// internacional de triagem de risco, considerado obrigatorio antes de qualquer
/// programa de treinamento. Instrumento FECHADO: 7 perguntas sim/nao, por isso
/// 7 colunas nomeadas e nao uma lista generica — o conjunto nao varia, e cada
/// item tem significado clinico proprio. O TEXTO de cada pergunta vive no i18n
/// (D-066); aqui so a resposta.
model AnamnesisParq {
  id          String @id @default(cuid())
  anamnesisId String @unique // 1:1 com a anamnese (a secao ou existe, ou nao)

  /// 1. Algum medico ja disse que voce possui problema cardiaco e que so deveria
  /// fazer atividade fisica supervisionado por profissional de saude?
  heartCondition Boolean

  /// 2. Voce sente dor no peito quando pratica atividade fisica?
  chestPainDuringActivity Boolean

  /// 3. No ultimo mes, voce sentiu dor no peito ao praticar atividade fisica?
  chestPainAtRest Boolean

  /// 4. Voce apresenta desequilibrio devido a tontura e/ou perda de consciencia?
  dizzinessOrFainting Boolean

  /// 5. Voce possui algum problema osseo ou articular que poderia piorar com a
  /// pratica de atividade fisica?
  boneOrJointProblem Boolean

  /// 6. Voce toma atualmente algum medicamento para pressao arterial ou problema
  /// cardiaco?
  bloodPressureOrHeartMedication Boolean

  /// 7. Sabe de alguma outra razao pela qual nao deveria praticar atividade
  /// fisica?
  otherReason       Boolean
  otherReasonDetail String? // condicional do item 7: so quando `otherReason`

  // Autoria da secao (D-102)
  authoredBy          AnamnesisAuthor
  authoredByAccountId String
  authoredAt          DateTime        @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  anamnesis         Anamnesis @relation(fields: [anamnesisId], references: [id], onDelete: Cascade)
  authoredByAccount Account   @relation(fields: [authoredByAccountId], references: [id], onDelete: Restrict)

  @@map("anamnesis_parq")
}

/// Objetivo e expectativa (D-103). Texto livre de proposito: nenhum ADR decidiu
/// uma taxonomia de objetivos (emagrecimento/hipertrofia/...), e inventa-la aqui
/// seria criar regra de negocio. Espelha WorkoutPlan.goal (D-095).
model AnamnesisGoal {
  id          String @id @default(cuid())
  anamnesisId String @unique

  goal        String // o que o paciente quer alcancar
  expectation String? // o que ele espera do processo/profissional

  authoredBy          AnamnesisAuthor
  authoredByAccountId String
  authoredAt          DateTime        @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  anamnesis         Anamnesis @relation(fields: [anamnesisId], references: [id], onDelete: Cascade)
  authoredByAccount Account   @relation(fields: [authoredByAccountId], references: [id], onDelete: Restrict)

  @@map("anamnesis_goal")
}

/// Historico clinico (D-103): doencas, cirurgias, medicamentos, alergias. Cada
/// um e CONDICIONAL — boolean explicito + filhas. `false` = respondeu que nao
/// tem; `null` (linha da secao ausente) = nao foi perguntado.
model AnamnesisClinicalHistory {
  id          String @id @default(cuid())
  anamnesisId String @unique

  hasConditions   Boolean // -> AnamnesisCondition[]
  hasSurgeries    Boolean // -> AnamnesisSurgery[]
  takesMedication Boolean // -> AnamnesisMedication[]
  hasAllergies    Boolean // -> AnamnesisAllergy[]

  authoredBy          AnamnesisAuthor
  authoredByAccountId String
  authoredAt          DateTime        @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  anamnesis         Anamnesis @relation(fields: [anamnesisId], references: [id], onDelete: Cascade)
  authoredByAccount Account   @relation(fields: [authoredByAccountId], references: [id], onDelete: Restrict)

  conditions  AnamnesisCondition[]
  surgeries   AnamnesisSurgery[]
  medications AnamnesisMedication[]
  allergies   AnamnesisAllergy[]

  @@map("anamnesis_clinical_history")
}

/// Doenca declarada. Lista, nunca texto corrido — o dado precisa ser consultavel.
model AnamnesisCondition {
  id                String   @id @default(cuid())
  clinicalHistoryId String
  name              String
  note              String?
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  clinicalHistory AnamnesisClinicalHistory @relation(fields: [clinicalHistoryId], references: [id], onDelete: Cascade)

  @@index([clinicalHistoryId])
  @@map("anamnesis_condition")
}

/// Cirurgia declarada. `year` em vez de data completa: o paciente raramente
/// lembra o dia, e exigir precisao inexistente produz dado falso.
model AnamnesisSurgery {
  id                String   @id @default(cuid())
  clinicalHistoryId String
  name              String
  year              Int?
  note              String?
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  clinicalHistory AnamnesisClinicalHistory @relation(fields: [clinicalHistoryId], references: [id], onDelete: Cascade)

  @@index([clinicalHistoryId])
  @@map("anamnesis_surgery")
}

/// Medicamento declarado. `posology` e OPCIONAL de proposito e e o exemplo
/// canonico do D-102: no HIBRIDO o paciente declara "remedio pra pressao"
/// (posologia nula) e o PROFISSIONAL refina para "Losartana 50mg 1x/dia" — a
/// autoria da secao registra quem disse o que.
model AnamnesisMedication {
  id                String   @id @default(cuid())
  clinicalHistoryId String
  name              String
  posology          String? // preenchido/refinado pelo profissional (D-102)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  clinicalHistory AnamnesisClinicalHistory @relation(fields: [clinicalHistoryId], references: [id], onDelete: Cascade)

  @@index([clinicalHistoryId])
  @@map("anamnesis_medication")
}

/// Alergia declarada (D-103, nucleo). Distinta de intolerancia alimentar, que e
/// do modulo de nutricao (fase seguinte).
model AnamnesisAllergy {
  id                String   @id @default(cuid())
  clinicalHistoryId String
  name              String
  reaction          String?
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  clinicalHistory AnamnesisClinicalHistory @relation(fields: [clinicalHistoryId], references: [id], onDelete: Cascade)

  @@index([clinicalHistoryId])
  @@map("anamnesis_allergy")
}

/// Antecedentes familiares (D-103). Condicional: `hasFamilyHistory` + filhas.
model AnamnesisFamilyHistory {
  id          String @id @default(cuid())
  anamnesisId String @unique

  hasFamilyHistory Boolean

  authoredBy          AnamnesisAuthor
  authoredByAccountId String
  authoredAt          DateTime        @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  anamnesis         Anamnesis @relation(fields: [anamnesisId], references: [id], onDelete: Cascade)
  authoredByAccount Account   @relation(fields: [authoredByAccountId], references: [id], onDelete: Restrict)

  conditions AnamnesisFamilyCondition[]

  @@map("anamnesis_family_history")
}

/// Antecedente familiar: qual condicao, em quem. `relationship` livre (mae, pai,
/// irmao) — nenhum ADR decidiu um enum de parentesco.
model AnamnesisFamilyCondition {
  id              String   @id @default(cuid())
  familyHistoryId String
  name            String
  relationship    String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  familyHistory AnamnesisFamilyHistory @relation(fields: [familyHistoryId], references: [id], onDelete: Cascade)

  @@index([familyHistoryId])
  @@map("anamnesis_family_condition")
}

/// Estilo de vida (D-103): sono, estresse, fumo, alcool. Fumo e alcool sao
/// condicionais (boolean + detalhe). A FAIXA de `stressLevel` e validada no Zod
/// (a "escala visual" do D-103 e UX): o banco guarda o inteiro, nao a regra.
model AnamnesisLifestyle {
  id          String @id @default(cuid())
  anamnesisId String @unique

  sleepHoursPerNight Int? // horas por noite
  stressLevel        Int? // escala (faixa validada na aplicacao — UX do D-103)

  smokes        Boolean
  smokingNote   String? // condicional: so quando `smokes`
  drinksAlcohol Boolean
  alcoholNote   String? // condicional: so quando `drinksAlcohol`

  authoredBy          AnamnesisAuthor
  authoredByAccountId String
  authoredAt          DateTime        @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  anamnesis         Anamnesis @relation(fields: [anamnesisId], references: [id], onDelete: Cascade)
  authoredByAccount Account   @relation(fields: [authoredByAccountId], references: [id], onDelete: Restrict)

  @@map("anamnesis_lifestyle")
}

/// Contato de emergencia (D-103). Nao vem do cadastro: e dado do contexto de
/// atendimento, nao da identidade da conta.
model AnamnesisEmergencyContact {
  id          String @id @default(cuid())
  anamnesisId String @unique

  name         String
  phone        String
  relationship String?

  authoredBy          AnamnesisAuthor
  authoredByAccountId String
  authoredAt          DateTime        @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  anamnesis         Anamnesis @relation(fields: [anamnesisId], references: [id], onDelete: Cascade)
  authoredByAccount Account   @relation(fields: [authoredByAccountId], references: [id], onDelete: Restrict)

  @@map("anamnesis_emergency_contact")
}

/// MODULO TREINO (D-103) — so em vinculos de TRAINING. Soma-se ao nucleo.
///
/// Fundamento juridico (ADR-0011): o profissional de educacao fisica responde
/// por tudo que ocorrer em decorrencia dos exercicios prescritos — a
/// documentacao e o respaldo dele. Nao e burocracia, e defesa.
model AnamnesisTraining {
  id          String @id @default(cuid())
  anamnesisId String @unique

  hasPreviousExperience Boolean
  previousExperience    String? // condicional: so quando `hasPreviousExperience`

  availableDaysPerWeek Int? // disponibilidade (D-103)
  preferredTime        String? // horario preferido (texto livre — sem taxonomia decidida)

  hasInjury Boolean // -> AnamnesisInjury[] (dor/lesao musculoesqueletica "detalhada")

  usesAnabolicSteroids Boolean
  anabolicSteroidsNote String? // condicional: so quando `usesAnabolicSteroids`

  preferences String? // preferencias e aversoes (D-103)
  aversions   String?

  authoredBy          AnamnesisAuthor
  authoredByAccountId String
  authoredAt          DateTime        @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  anamnesis         Anamnesis @relation(fields: [anamnesisId], references: [id], onDelete: Cascade)
  authoredByAccount Account   @relation(fields: [authoredByAccountId], references: [id], onDelete: Restrict)

  injuries AnamnesisInjury[]

  @@map("anamnesis_training")
}

/// Dor/lesao musculoesqueletica — o D-103 pede "detalhada", entao e lista com
/// regiao + descricao, nao um campo de texto solto.
model AnamnesisInjury {
  id         String @id @default(cuid())
  trainingId String

  bodyRegion  String
  description String
  /// Desde quando (aproximado). Ver AnamnesisSurgery.year: exigir data exata de
  /// memoria produz dado falso.
  sinceYear   Int?
  isCurrent   Boolean @default(false) // dor ativa x historico

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  training AnamnesisTraining @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@index([trainingId])
  @@map("anamnesis_injury")
}

/// Avaliacao / medidas recorrentes, atada a um VINCULO (Bond) e ISOLADA POR
/// VINCULO (ADR-0001). Distinta da Anamnesis (gate, unica — D-094): esta e
/// RECORRENTE. Sem formulario generico unico: os campos POR ESPECIALIDADE
/// seguem deferidos para `detail Json?` (TODO D-063) — o ADR-0009 fechou a
/// prescricao de treino, nao a taxonomia de medidas. tenantId denormalizado para
/// escopo (D-002). Datas em UTC (D-067).
model Assessment {
  id        String   @id @default(cuid())
  tenantId  String // escopo denormalizado (D-002)
  bondId    String // isolamento por vinculo (ADR-0001)
  detail    Json? // TODO(D-063): campos por especialidade — nao inventar
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bond   Bond   @relation(fields: [bondId], references: [id], onDelete: Cascade)

  @@index([bondId])
  @@index([tenantId])
  @@map("assessment")
}

/// Foto de evolucao — apenas a referencia de storage (storageKey S3), ISOLADA POR
/// VINCULO (ADR-0001). O binario vive no storage (S3-compatible); aqui so a chave.
/// tenantId denormalizado para escopo (D-002). Datas em UTC (D-067).
model ProgressPhoto {
  id         String    @id @default(cuid())
  tenantId   String // escopo denormalizado (D-002)
  bondId     String // isolamento por vinculo (ADR-0001)
  storageKey String // referencia do objeto no storage S3-compatible (sem binario aqui)
  takenAt    DateTime? @db.Timestamptz(3) // quando a foto foi tirada (estrutural; UTC)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bond   Bond   @relation(fields: [bondId], references: [id], onDelete: Cascade)

  @@index([bondId])
  @@index([tenantId])
  @@map("progress_photo")
}

// ---------------------------------------------------------------------------
// Atendimento (D-096 — ADR-0010)
//
// NAO e "chat" (promete instantaneidade) nem "suporte" (soa a bug do app). E um
// TICKET: o aluno abre por formulario interativo, vira conversa, fica PENDING
// ate ser resolvido e gera avaliacao ao concluir.
//
// E DADO CLINICO (D-096): isolado por vinculo (ADR-0001), escopado por tenant
// (D-002) e FORA DO ALCANCE DO ADMIN PURO (D-015). Qualquer query sem escopo de
// vinculo/tenant aqui e vazamento, nao bug de listagem. Tira a conversa do
// WhatsApp e cria registro auditavel.
//
// A ESCALADA (2h push -> 24h push+email -> 48h alerta no painel) e regua de
// WORKER: ela le `readAt`/`lastMessageAt` e avanca `escalationLevel`. A
// insistencia MIGRA DE CANAL de proposito — martelar o mesmo canal faz o
// profissional silenciar a notificacao e perde-se o canal.
//
// IA AQUI E TRIAGEM, NAO RESPOSTA (D-096/D-023): a sugestao e transiente, o
// profissional edita e envia. Por isso NAO ha campo de rascunho de IA — nada de
// IA responde direto ao aluno sobre treino/saude.
// ---------------------------------------------------------------------------

/// Atendimento = thread/ticket de um vinculo (D-096). Dado clinico.
model Attendance {
  id                String           @id @default(cuid())
  tenantId          String // escopo denormalizado (D-002)
  bondId            String // isolamento por vinculo (ADR-0001) — dado clinico
  openedByAccountId String // quem abriu (normalmente o aluno)
  subject           String // vem do formulario interativo de abertura (D-096)
  status            AttendanceStatus @default(PENDING)
  lastMessageAt     DateTime         @default(now()) @db.Timestamptz(3) // relogio da escalada + ordenacao (D-096)
  escalationLevel   Int              @default(0) // 0=nenhuma, 1=2h, 2=24h, 3=48h (worker — D-096)
  resolvedAt        DateTime?        @db.Timestamptz(3) // conclusao (UTC)
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bond     Bond                @relation(fields: [bondId], references: [id], onDelete: Cascade)
  openedBy Account             @relation(fields: [openedByAccountId], references: [id], onDelete: Cascade)
  messages AttendanceMessage[]
  rating   AttendanceRating?

  @@index([bondId, status]) // pendentes/concluidas do vinculo
  @@index([tenantId, status]) // painel do profissional (D-098)
  @@index([status, lastMessageAt]) // varredura da escalada (worker — D-096)
  @@map("attendance")
}

/// Mensagem de um atendimento (D-096). `readAt` e o que sustenta a escalada
/// ("nao leu em 2h", "nao leu em 24h") e o indicador de mensagens sem resposta
/// (D-092).
model AttendanceMessage {
  id              String    @id @default(cuid())
  attendanceId    String
  senderAccountId String
  body            String
  readAt          DateTime? @db.Timestamptz(3) // nulo = nao lida; base da escalada (D-096)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  sender     Account    @relation(fields: [senderAccountId], references: [id], onDelete: Cascade)

  @@index([attendanceId, createdAt])
  @@index([attendanceId, readAt]) // nao lidas -> escalada (D-096)
  @@map("attendance_message")
}

/// Avaliacao do atendimento resolvido (D-096) — uma por atendimento.
model AttendanceRating {
  id           String   @id @default(cuid())
  attendanceId String   @unique // uma avaliacao por ticket (D-096)
  score        Int
  comment      String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@map("attendance_rating")
}

// ---------------------------------------------------------------------------
// Notificacoes (D-097 — ADR-0010 / D-028 — ADR-0005)
//
// O D-028 (ADR-0005) DESCREVEU a central in-app com soft delete e o log legal de
// notificacoes sensiveis, mas o modelo NUNCA foi criado no schema. Nasce aqui.
//
// Notificacao e PILAR DE RETENCAO (D-097), nao acessorio. O disparo multi-canal
// (push/FCM, e-mail, SMS) vive em @fitvo/notifications; aqui persiste o canal
// IN-APP (o sininho) e o rastro.
// ---------------------------------------------------------------------------

/// Notificacao in-app de uma conta (D-097/D-028). Soft delete: a central
/// persiste ate o usuario apagar. `sensitive` marca as notificacoes financeiras
/// e de consentimento, que sao mantidas em log por obrigacao legal e NAO devem
/// ser expurgadas junto com o resto (D-028/ADR-0005).
///
/// `data Json?` e Json LEGITIMO: e payload de ROTEAMENTO (deep-link, ids de
/// destino), nao conteudo de dominio — a regra de matar o Json (ADR-0009) mira o
/// dominio. O texto exibido vem do i18n a partir de `type` (D-066).
model Notification {
  id        String           @id @default(cuid())
  accountId String // destinatario
  type      NotificationType
  title     String
  body      String
  data      Json? // payload de deep-link/roteamento (Json legitimo — ver doc acima)
  sensitive Boolean          @default(false) // financeiro/consentimento: retido por lei (D-028)
  readAt    DateTime?        @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)
  deletedAt DateTime?        @db.Timestamptz(3) // soft delete da central in-app (D-028)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, readAt]) // sininho: nao lidas
  @@index([accountId, createdAt]) // feed da central (cursor — D-036)
  @@map("notification")
}

// =============================================================================
// AGENDA (ADR-0012 — D-106 a D-111)
// =============================================================================
//
// FUSO (D-111 + adendo): duas naturezas de dado, e confundi-las e o bug.
// - INSTANTE (Appointment, AvailabilityException) -> `timestamptz`. Ponto unico
//   na linha do tempo.
// - JANELA RECORRENTE (AvailabilityRule) -> hora de PAREDE (minutos desde a
//   meia-noite) + fuso IANA. "Atendo 9h-18h" NAO e instante: guardar em UTC
//   congela um offset e a janela desliza uma hora quando o DST entra/sai.
//
// TIMESTAMPTZ e nao TIMESTAMP: o Prisma mapeia DateTime para `timestamp(3)` SEM
// fuso por padrao — guardar UTC ali e convencao por esperanca. Verificado: com a
// sessao em America/Sao_Paulo, `DEFAULT CURRENT_TIMESTAMP` numa coluna sem fuso
// grava a hora LOCAL (3h de erro, sem erro nenhum). Tabelas novas: sem custo.
//
// O PAR PRESCRICAO -> EXECUCAO, pela terceira vez: Appointment (marcado) ->
// Encounter (realizado) e o mesmo shape de WorkoutPlan->WorkoutSession (D-086) e
// MealPlan->MealLog (D-118). As estatisticas do D-110 sao o indicador de
// aderencia DESSE par — "no-show" e "prescrito e nao executado".
// -----------------------------------------------------------------------------

/// Estado do agendamento (D-108/D-110).
enum AppointmentStatus {
  SCHEDULED // marcado, aguardando confirmacao do paciente
  CONFIRMED // paciente confirmou presenca (D-108)
  CANCELLED // desmarcado — alimenta a estatistica de desmarcacoes (D-110)
  COMPLETED // ocorreu -> tipicamente gera Encounter (D-110)
  NO_SHOW // paciente faltou sem desmarcar — prejuizo direto (D-108/D-110)
}

/// Tipo do servico oferecido (D-109). O ciclo consulta -> retorno e conceito de
/// NUTRICAO e MEDICINA; personal trainer tem consultoria continua e simplesmente
/// NAO tem linha de servico RETURN — ausencia de linha, nao flag.
enum ProfessionalServiceType {
  FIRST_VISIT // primeira consulta
  RETURN // retorno (D-109)
  OTHER // avaliacao fisica, reavaliacao etc.
}

/// Servico do profissional POR ESPECIALIDADE (D-109). Nao por profissional: uma
/// pessoa pode ter TRAINING e NUTRITION (ProfessionalSpecialty e N:N), e retorno
/// nao se aplica a personal — politica por profissional mentiria para uma das duas.
///
/// SUBSTITUI a "ReturnPolicy" que o D-109 sugeria. O enum grátis/reduzido/cheio
/// seria DERIVAVEL do preco (0 = gratis; menor que o FIRST_VISIT = reduzido;
/// igual = cheio) — e o teste do ADR-0011 diz: se a fonte mudar, este campo deve
/// mudar junto? SIM (mudar o preco do retorno muda a politica). Logo: DERIVE, nao
/// armazene. Guardar os dois seria o `Bond.anamnesisCompletedAt` (D-093) de novo.
///
/// "Nao faco retorno" = NENHUMA linha RETURN. "Faco e nao cobro" = linha com
/// priceCents = 0. O enum colapsaria os dois — mesma disciplina do "secao ausente
/// = linha ausente" da anamnese (D-103).
model ProfessionalService {
  id                      String                  @id @default(cuid())
  professionalSpecialtyId String
  name                    String // "Consulta inicial", "Retorno", "Avaliacao fisica"
  durationMinutes         Int // sem isto nao existe slot a oferecer (D-106)
  priceCents              Int // centavos inteiros, nunca float (D-069)
  type                    ProfessionalServiceType
  active                  Boolean                 @default(true) // delecao logica (D-089): servico descontinuado some da oferta mas sobrevive no historico

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  professionalSpecialty ProfessionalSpecialty @relation(fields: [professionalSpecialtyId], references: [id], onDelete: Cascade)
  appointments          Appointment[]

  @@index([professionalSpecialtyId, active]) // oferta vigente da especialidade
  @@map("professional_service")
}

/// Configuracao de agenda do profissional. Existe para que o fuso das janelas
/// seja UM SO: se `timezone` morasse em cada AvailabilityRule, seria
/// representavel ter segunda em Sao Paulo e terca em Lisboa.
///
/// NAO deriva de `Account.preferredTimezone`: aquilo e preferencia de EXIBICAO
/// (D-067). Trocar o fuso de exibicao nao pode mover silenciosamente o horario de
/// atendimento de ninguem — sao dois fatos diferentes que costumam coincidir.
model ProfessionalAgendaSettings {
  id                    String @id @default(cuid())
  professionalProfileId String @unique

  /// Fuso IANA das JANELAS de disponibilidade (D-111 adendo). Ex.: "America/Sao_Paulo".
  timezone String

  /// Lembretes: horas antes do agendamento (D-108). Lista porque o profissional
  /// configura quantos quiser (ex.: [48, 2]). Vazio = sem lembrete.
  reminderHoursBefore Int[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)

  @@map("professional_agenda_settings")
}

/// Janela recorrente de disponibilidade (D-106). HORA DE PAREDE, nao instante —
/// ver o bloco de fuso no topo. A expansao para instantes UTC acontece na
/// CONSULTA, aplicando o DST vigente naquela data.
///
/// `startMinute`/`endMinute` = minutos desde a meia-noite (0..1440), hora LOCAL do
/// fuso de ProfessionalAgendaSettings. Int e nao `@db.Time` de proposito: o Prisma
/// devolveria `@db.Time` como um `Date` completo com data falsa (1970-01-01) — um
/// tipo que mente. Inteiro nao mente: e deslocamento dentro do dia.
///
/// Por PROFISSIONAL, nao por especialidade: o tempo dele e fisico e unico (ele nao
/// atende treino e nutricao as 9h). A especialidade entra pelo VINCULO do
/// agendamento.
model AvailabilityRule {
  id                    String  @id @default(cuid())
  professionalProfileId String
  weekday               Weekday
  startMinute           Int // minutos desde 00:00, hora local (ex.: 540 = 09:00)
  endMinute             Int // minutos desde 00:00, hora local (ex.: 1080 = 18:00)
  active                Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)

  @@index([professionalProfileId, weekday])
  @@map("availability_rule")
}

/// Bloqueio pontual: ferias, feriado, compromisso (D-106). OCORRENCIA CONCRETA,
/// nao regra — por isso INSTANTE (`timestamptz`), diferente da AvailabilityRule.
model AvailabilityException {
  id                    String   @id @default(cuid())
  professionalProfileId String
  startsAt              DateTime @db.Timestamptz(3)
  endsAt                DateTime @db.Timestamptz(3)
  reason                String? // texto livre; nenhum ADR decidiu taxonomia de motivo

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)

  @@index([professionalProfileId, startsAt])
  @@map("availability_exception")
}

/// Agendamento (D-106). Atado ao VINCULO (isolamento — ADR-0001) + tenantId
/// denormalizado (D-002). Uma consulta com nutrologo E informacao clinica por
/// contexto: escopo de tenant e isolamento por vinculo valem aqui como no resto, e
/// admin puro nao ve conteudo clinico (D-015).
///
/// `professionalProfileId` DENORMALIZADO do Bond: a constraint EXCLUDE precisa de
/// todas as colunas na MESMA linha, e o conflito e "dois agendamentos do mesmo
/// profissional se sobrepoem". Nao vira fonte divergente: a FK e COMPOSTA
/// (bondId + professionalProfileId -> Bond.id + Bond.professionalProfileId), entao
/// um valor que nao bata com o vinculo e IRREPRESENTAVEL — o banco recusa.
/// Construir, nao validar (D-102).
///
/// TERMOS CONGELADOS (`priceCentsAtBooking`, `serviceTypeAtBooking`): o preco e o
/// tipo do ProfessionalService MUDAM quando o profissional reajusta a tabela. Ler
/// pelo FK na hora de cobrar um agendamento antigo seria o join com o preco ATUAL
/// — exatamente o que o ADR-0011 proibe. Mesmo teste, resposta oposta a do
/// ReturnPolicy: aqui a fonte muda e este campo NAO deve mudar junto (o preco
/// acordado e historico) -> ARMAZENE. E o preco registrado na compra.
model Appointment {
  id                    String @id @default(cuid())
  tenantId              String // escopo denormalizado (D-002)
  bondId                String // isolamento por vinculo (ADR-0001)
  professionalProfileId String // denormalizado do Bond; FK composta impede divergir
  serviceId             String

  startsAt DateTime          @db.Timestamptz(3) // INSTANTE, UTC (D-111)
  endsAt   DateTime          @db.Timestamptz(3)
  status   AppointmentStatus @default(SCHEDULED)

  /// Termos acordados no ato da marcacao — congelados (ver nota acima).
  priceCentsAtBooking  Int
  serviceTypeAtBooking ProfessionalServiceType

  confirmedAt DateTime? @db.Timestamptz(3) // confirmacao de presenca (D-108)
  cancelledAt DateTime? @db.Timestamptz(3) // desmarcacao (D-110). QUEM desmarcou nao esta decidido — nao inventar.

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tenant  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bond    Bond                @relation(fields: [bondId, professionalProfileId], references: [id, professionalProfileId], onDelete: Cascade)
  service ProfessionalService @relation(fields: [serviceId], references: [id], onDelete: Restrict) // servico descontinuado nao pode sumir do historico

  encounter Encounter? // o par prescricao->execucao (ver bloco do topo)

  @@index([professionalProfileId, startsAt]) // agenda do dia + suporte ao EXCLUDE
  @@index([bondId, startsAt]) // historico do vinculo
  @@index([tenantId, startsAt]) // estatisticas da clinica (D-110)
  @@index([status, startsAt]) // varredura do worker de lembretes (D-108)
  @@map("appointment")
}
