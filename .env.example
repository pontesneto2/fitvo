# ==========================================================================
# FITVO — .env.example (RAIZ)
# Copie para .env (ignorado pelo git) e NUNCA versione valores reais.
# Cada app tem tambem seu proprio .env.example. Este arquivo documenta o
# conjunto comum e os segredos sensiveis. Em staging/producao, os valores sao
# injetados pela plataforma (Railway/Vercel/GitHub Actions), nunca no repo.
# ==========================================================================

# --- Ambiente ---
NODE_ENV=development
LOG_LEVEL=info

# --- Banco de dados (Postgres) ---
# Local: credenciais/porta conforme docker/.env (docker-compose).
# PORTA 5434, NAO 5432: a 5432 costuma estar ocupada por um Postgres NATIVO na
# maquina — usar 5432 faz o repo conectar no banco ERRADO silenciosamente (o
# sintoma e auth failure com a credencial certa). Ver docs/troubleshooting.md.
#
# DOIS roles diferentes (D-155, ADR-0017 Slice 3/3) — RLS so protege de
# verdade se o runtime da app NAO conectar como superuser/BYPASSRLS:
# - Migrations (packages/database/.env, prisma CLI): role privilegiado (fitvo).
# - Runtime da API/worker (apps/api/.env, apps/worker/.env): fitvo_app, sem
#   BYPASSRLS/SUPERUSER, + fitvo_webhook (WEBHOOK_DATABASE_URL) so para o
#   webhook Asaas/regua de cobranca. Ver docs/troubleshooting.md.
DATABASE_URL=postgresql://fitvo:change-me@localhost:5434/fitvo?schema=public

# --- Redis (cache/filas) ---
REDIS_URL=redis://localhost:6379

# --- Auth (JWT) — placeholders; gerar segredos fortes por ambiente ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# --- Integracoes (placeholders — preencher por ambiente na plataforma) ---
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
OPENAI_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Storage (S3-compatible) ---
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
