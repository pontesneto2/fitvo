# @fitvo/api — variaveis de ambiente (placeholders). Copie para apps/api/.env.
NODE_ENV=development
LOG_LEVEL=info
PORT=3333
HOST=0.0.0.0
CORS_ORIGIN=*

# Banco e cache (local: docker/docker-compose.yml)
# PORTA 5434, NAO 5432 — a 5432 costuma ser de um Postgres NATIVO da maquina e a
# API conectaria no banco errado sem avisar. Ver docs/troubleshooting.md.
# Role de RUNTIME da app (D-155, ADR-0017 Slice 3/3): fitvo_app, SEM
# BYPASSRLS/SUPERUSER -- RLS so protege de verdade com um role restrito.
# Migrations continuam rodando com o role privilegiado (fitvo). Precisa do
# CREATE ROLE previo -- ver docs/troubleshooting.md.
DATABASE_URL=postgresql://fitvo_app:change-me@localhost:5434/fitvo?schema=public
# Role administrativo estreito (ADR-0017 D-152/D-155): so para o webhook Asaas
# e a regua de cobranca do worker atualizarem charge/subscription sem
# tenantId conhecido a priori (cruzam tenant de proposito). SELECT+UPDATE
# apenas nessas duas tabelas -- nunca o client padrao da app.
WEBHOOK_DATABASE_URL=postgresql://fitvo_webhook:change-me@localhost:5434/fitvo?schema=public
REDIS_URL=redis://localhost:6379

# Auth (JWT) — gerar segredos fortes por ambiente; min. 16 chars
JWT_ACCESS_SECRET=change-me-access-secret-min-16
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_ISSUER=fitvo-api

# Convite admin->profissional — validade em segundos (default 7 dias, D-055)
PROFESSIONAL_INVITE_TTL_SECONDS=604800
# Convite profissional->paciente — validade em segundos (default 7 dias, D-055)
PATIENT_INVITE_TTL_SECONDS=604800

# Financeiro / Asaas (ADR-0004) — LIVE GATED. Todas OPCIONAIS: sem elas a API
# sobe e usa o FakePaymentGateway deterministico. NUNCA colocar segredos reais
# aqui nem no repo (publico) — apenas placeholders. Rotacionar se vazar.
ASAAS_API_KEY=change-me-asaas-api-key
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_WEBHOOK_SECRET=change-me-asaas-webhook-secret
ASAAS_PLATFORM_WALLET_ID=change-me-fitvo-wallet-id

# Storage S3-compatible (ADR-0005) — LIVE GATED. Todas OPCIONAIS: sem elas a API
# usa o InMemoryStorage. "S3-compatible" nao implica AWS (endpoint/path-style
# para MinIO/R2/Backblaze). NUNCA colocar segredos reais aqui.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=change-me-bucket
S3_ACCESS_KEY_ID=change-me-s3-access-key
S3_SECRET_ACCESS_KEY=change-me-s3-secret-key
S3_FORCE_PATH_STYLE=false

# IA (ADR-0005/D-024) — LIVE GATED. Sem ANTHROPIC_API_KEY a API usa o
# FakeAIProvider deterministico. Provider inicial: Anthropic (REST via fetch).
ANTHROPIC_API_KEY=change-me-anthropic-api-key
ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_MODEL=claude-3-5-sonnet-latest

# Notificacoes (ADR-0005/D-027) — providers externos GATED. Sem chaves os canais
# push/email/sms caem no LoggingNotificationSender; a central in-app persiste.
FCM_SERVER_KEY=change-me-fcm-server-key
EMAIL_PROVIDER_API_KEY=change-me-email-provider-key
SMS_PROVIDER_API_KEY=change-me-sms-provider-key
