// FITVO — Prisma schema.
// Fase 2 (fatia 1): identidade + tenancy. Sem vinculo/consentimento/financeiro
// ainda (fases seguintes). Datas em UTC (D-067); dinheiro nao aparece aqui.
//
// Fundamentos (ADRs):
// - Account (identidade) separada dos perfis de papel; 1 conta = N papeis
//   (D-041/D-044). Login por e-mail unico (D-042). Documento fiscal (D-043).
// - Tenant = clinica ou profissional solo (tenant de 1) (D-012/D-045).
// - Profissional tem N especialidades, cada uma verificada pela plataforma
//   (D-008/D-046). Especialidades = catalogo fixo (D-047).
// - RBAC 4 niveis; admin de clinica desacoplado de profissional (D-013/D-015).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum TenantType {
  SOLO // profissional solo: tenant de 1 pessoa (auto-criado)
  CLINIC // clinica: tenant multiprofissional
}

enum DocumentType {
  CPF
  CNPJ
}

enum SpecialtyCode {
  TRAINING // treino / educacao fisica (CREF)
  NUTRITION // nutricao (CRN)
  MEDICINE // medicina (CRM)
}

enum VerificationStatus {
  PENDING // cadastrado, aguardando envio/analise
  IN_ANALYSIS // documentos em revisao pela plataforma
  VERIFIED // habilitado a atender naquela especialidade
  REJECTED
}

enum ClinicRole {
  CLINIC_ADMIN // admin de clinica (visao ampla, dado operacional; nunca clinico)
}

enum InviteStatus {
  PENDING // aguardando aceite do profissional
  ACCEPTED // aceito: profissional vinculado a clinica
  EXPIRED // expirado (expiresAt no passado) sem aceite
  REVOKED // revogado pelo admin antes do aceite
}

/// Estado do vinculo paciente<->profissional (D-052/D-053). Encerrar um vinculo
/// nao apaga dados: vira ARQUIVO e o historico e preservado (D-053).
enum BondStatus {
  ACTIVE // vinculo aberto: o "ambiente" da especialidade esta habilitado
  ARCHIVED // encerrado: dados preservados, paciente segue vendo o historico
}

/// Estado da autorizacao de compartilhamento do paciente (D-016/ADR-0003). O
/// paciente concede (ACTIVE) e revoga (REVOKED) granularmente. Default minimo:
/// so dois estados — o "grant" e sempre um ato explicito do paciente.
enum ConsentStatus {
  ACTIVE // autorizacao vigente
  REVOKED // revogada pelo paciente (revokedAt preenchido)
}

/// Estado de uma sugestao de compartilhamento emitida pelo motor (D-017). A
/// sugestao NAO compartilha nada por si — ela apenas convida o paciente a
/// autorizar. PENDING ao ser criada; DISMISSED se o paciente ignora; ACTED se
/// leva a um consentimento. (Transicoes DISMISSED/ACTED ficam para a fase de
/// notificacoes — D-028; aqui o motor so cria PENDING.)
enum SuggestionStatus {
  PENDING
  DISMISSED
  ACTED
}

// ---------------------------------------------------------------------------
// Identidade
// ---------------------------------------------------------------------------

/// Conta = identidade unica de login. Acumula N papeis (profissional, paciente,
/// admin de clinica, super admin) sob a mesma conta (D-041/D-044).
model Account {
  id                String       @id @default(cuid())
  email             String       @unique
  passwordHash      String
  name              String
  document          String // CPF ou CNPJ da PESSOA (D-043)
  documentType      DocumentType
  emailVerifiedAt   DateTime?
  preferredLocale   String       @default("pt-BR") // i18n (D-066)
  preferredTimezone String       @default("America/Sao_Paulo") // exibicao (D-067)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  professionalProfile ProfessionalProfile?
  patientProfile      PatientProfile?
  platformAdmin       PlatformAdmin?
  clinicMemberships   ClinicMembership[]

  @@map("account")
}

/// Super Admin FITVO (gestao da plataforma inteira — D-013).
model PlatformAdmin {
  id        String   @id @default(cuid())
  accountId String   @unique
  createdAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("platform_admin")
}

// ---------------------------------------------------------------------------
// Tenancy (clinica / solo)
// ---------------------------------------------------------------------------

/// Unidade de isolamento de dados e cobranca. Solo = tenant de 1 (auto-criado);
/// clinica = tenant multiprofissional com admin (D-012/D-045).
model Tenant {
  id           String        @id @default(cuid())
  type         TenantType
  name         String
  document     String? // CNPJ da CLINICA mora aqui (D-043); solo herda o da conta
  documentType DocumentType?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  professionals  ProfessionalProfile[]
  memberships    ClinicMembership[]
  invites        ProfessionalInvite[]
  patientInvites PatientInvite[]
  bonds          Bond[]

  @@map("tenant")
}

/// Vinculo de uma pessoa a uma clinica como ADMIN (papel desacoplado de
/// profissional — D-013/D-015). Admin puro nunca acessa dado clinico.
model ClinicMembership {
  id        String     @id @default(cuid())
  accountId String
  tenantId  String
  role      ClinicRole @default(CLINIC_ADMIN)
  createdAt DateTime   @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([accountId, tenantId])
  @@index([tenantId])
  @@map("clinic_membership")
}

// ---------------------------------------------------------------------------
// Perfis de papel: profissional e paciente
// ---------------------------------------------------------------------------

/// Perfil profissional (1:1 com a conta). Pertence a um tenant: o proprio
/// (solo) ou a clinica que o convidou (D-045/D-048).
model ProfessionalProfile {
  id          String   @id @default(cuid())
  accountId   String   @unique
  tenantId    String
  displayName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account          Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tenant           Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  specialties      ProfessionalSpecialty[]
  patientInvites   PatientInvite[]
  bonds            Bond[]
  consentsReceived Consent[] // consentimentos em que este profissional e o grantee (D-016)
  suggestionsAsA   SharingSuggestion[]     @relation("SuggestionProfessionalA")
  suggestionsAsB   SharingSuggestion[]     @relation("SuggestionProfessionalB")

  @@index([tenantId])
  @@map("professional_profile")
}

/// Especialidade do catalogo fixo da plataforma (D-047). Semeada na migracao.
model Specialty {
  id   String        @id @default(cuid())
  code SpecialtyCode @unique
  name String

  professionals      ProfessionalSpecialty[]
  patientInvites     PatientInvite[]
  bonds              Bond[]
  consents           Consent[]
  sharingSuggestions SharingSuggestion[]

  @@map("specialty")
}

/// Habilitacao do profissional numa especialidade, com status de verificacao
/// individual pela plataforma (D-046/D-010/D-051).
model ProfessionalSpecialty {
  id                    String             @id @default(cuid())
  professionalProfileId String
  specialtyId           String
  verificationStatus    VerificationStatus @default(PENDING)
  councilDocument       String? // registro no conselho (CREF/CRN/CRM)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  specialty           Specialty           @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  @@unique([professionalProfileId, specialtyId])
  @@index([specialtyId])
  @@map("professional_specialty")
}

/// Perfil de paciente (1:1 com a conta). Dados corporais globais e vinculos
/// entram na fase do dominio de paciente.
model PatientProfile {
  id        String   @id @default(cuid())
  accountId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account            Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  bonds              Bond[]
  consents           Consent[] // autorizacoes que ESTE paciente concedeu (D-016)
  sharingSuggestions SharingSuggestion[] // sugestoes do motor para este paciente (D-017)

  @@map("patient_profile")
}

// ---------------------------------------------------------------------------
// Convite admin de clinica -> profissional (D-014/D-048/D-049)
// ---------------------------------------------------------------------------

/// Convite de um admin de clinica para um profissional. E a UNICA porta de
/// entrada de um profissional numa clinica (D-048): quem se cadastra por fora
/// vira solo. Distinto do convite profissional->paciente (D-005, fase do
/// dominio de paciente). O token de uso unico e guardado SO como hash — o
/// segredo em claro nunca e persistido (mesma disciplina dos tokens de auth,
/// D-029). Expira em 7 dias por padrao (definido na aplicacao), espelhando a
/// convencao do convite de paciente (D-055). Datas em UTC (D-067).
model ProfessionalInvite {
  id        String       @id @default(cuid())
  tenantId  String // clinica que convida (escopo de tenant obrigatorio — D-002)
  email     String // e-mail do profissional convidado
  status    InviteStatus @default(PENDING)
  tokenHash String       @unique // sha256 do token de uso unico (nunca em claro)
  expiresAt DateTime // validade (default de 7 dias aplicado na camada de aplicacao)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("professional_invite")
}

// ---------------------------------------------------------------------------
// Convite profissional -> paciente + Vinculo (D-006/D-052/D-053/D-055)
// ---------------------------------------------------------------------------

/// Convite de um profissional para um paciente (D-006), direcionado a UMA
/// especialidade (D-052): o aceite abre o vinculo naquele "ambiente". Distinto
/// do convite admin->profissional (ProfessionalInvite). O token de uso unico e
/// guardado SO como hash — o segredo em claro nunca e persistido (mesma
/// disciplina dos tokens de auth, D-029). Expira em 7 dias e e reenviavel
/// (D-055): o reenvio rotaciona o token e estende a validade na mesma linha.
/// tenantId denormalizado = o tenant do profissional (escopo obrigatorio — D-002).
/// Datas em UTC (D-067).
model PatientInvite {
  id                    String       @id @default(cuid())
  tenantId              String // tenant do profissional que convida (escopo — D-002)
  professionalProfileId String // profissional que convida (D-006)
  specialtyId           String // especialidade-alvo do vinculo futuro (D-052)
  email                 String // e-mail do paciente convidado
  status                InviteStatus @default(PENDING)
  tokenHash             String       @unique // sha256 do token de uso unico (nunca em claro)
  expiresAt             DateTime // validade (7 dias por padrao, aplicado na aplicacao — D-055)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  specialty           Specialty           @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([professionalProfileId, status])
  @@index([email])
  @@map("patient_invite")
}

/// Vinculo = paciente <-> (profissional + especialidade) (D-052). E a entidade
/// central: anamnese, avaliacoes, treinos, cobrancas penduram no vinculo (fases
/// seguintes). Cada vinculo materializa um "ambiente" na UX do paciente. A
/// tripla (paciente, profissional, especialidade) e unica — "Leo educador" e
/// "Leo nutricionista" sao vinculos distintos. Encerrar vira ARQUIVO, nunca
/// apaga (D-053). tenantId denormalizado = tenant do profissional (escopo — D-002).
model Bond {
  id                    String     @id @default(cuid())
  tenantId              String // tenant do profissional (escopo denormalizado — D-002)
  patientProfileId      String
  professionalProfileId String
  specialtyId           String
  status                BondStatus @default(ACTIVE)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  archivedAt            DateTime? // momento do encerramento (UTC), null enquanto ativo (D-053)

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientProfile      PatientProfile      @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  specialty           Specialty           @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  @@unique([patientProfileId, professionalProfileId, specialtyId])
  @@index([tenantId])
  @@index([professionalProfileId, status])
  @@index([patientProfileId, status])
  @@map("bond")
}

// ---------------------------------------------------------------------------
// Consentimento + motor de compartilhamento (D-016/D-017/D-054 — ADR-0003)
// ---------------------------------------------------------------------------

/// Consentimento = autorizacao do PACIENTE para que um profissional (o
/// "grantee") acesse seus dados numa especialidade (D-016). Dominio de primeira
/// classe: compartilhamento entre profissionais e SEMPRE autorizado pelo
/// paciente, nunca automatico (ADR-0003).
///
/// DEFAULTS documentados:
/// - Granularidade = por (paciente + profissional que recebe + especialidade).
///   E o escopo minimo que a ADR pede ("granular, por profissional") somado a
///   dimensao de especialidade do produto multi-especialidade.
/// - Titularidade = o paciente. Diferente das demais entidades, o Consent NAO e
///   escopado por tenant: e o ato do proprio paciente e pode CRUZAR tenants (os
///   profissionais do paciente podem viver em tenants distintos). A chave de
///   escopo aqui e o patientProfileId, nao um tenantId. O isolamento de tenant
///   (D-002) continua valendo em toda OUTRA query do sistema.
/// - Unicidade = um consentimento por tripla (paciente, grantee, especialidade).
///   Revogar + reconceder REUSA/REABRE a MESMA linha (ACTIVE<->REVOKED), em vez
///   de inserir varias — escolha mais simples e sem historico duplicado nesta
///   fase (o historico fino de consentimento fica para uma fase futura).
/// Datas em UTC (D-067).
model Consent {
  id                           String        @id @default(cuid())
  patientProfileId             String // titular do dado (chave de escopo — nao ha tenantId aqui de proposito)
  granteeProfessionalProfileId String // profissional que RECEBE o acesso
  specialtyId                  String // escopo do que pode ser compartilhado (granular por especialidade)
  status                       ConsentStatus @default(ACTIVE)
  grantedAt                    DateTime      @default(now())
  revokedAt                    DateTime? // preenchido na revogacao (UTC), null enquanto ACTIVE
  createdAt                    DateTime      @default(now())
  updatedAt                    DateTime      @updatedAt

  patientProfile      PatientProfile      @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  granteeProfessional ProfessionalProfile @relation(fields: [granteeProfessionalProfileId], references: [id], onDelete: Cascade)
  specialty           Specialty           @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  @@unique([patientProfileId, granteeProfessionalProfileId, specialtyId])
  @@index([patientProfileId])
  @@index([granteeProfessionalProfileId, status])
  @@map("consent")
}

/// Sugestao de compartilhamento = saida do motor orientado a eventos (D-017). Ao
/// abrir um vinculo (bond.created), o worker detecta a SOBREPOSICAO (o paciente
/// passa a ter >=2 profissionais distintos) e cria uma sugestao PENDING para o
/// par recem-sobreposto. IMPORTANTE: a sugestao NAO compartilha nada — a entrega
/// por notificacao (D-028) e o ato de consentir sao passos posteriores.
///
/// DEFAULTS documentados:
/// - O par (professionalA, professionalB) e NORMALIZADO por ordem estavel dos
///   ids (A < B) para que (X,Y) e (Y,X) sejam a mesma sugestao — habilita dedupe.
/// - specialtyId = a especialidade do vinculo que DISPAROU a sobreposicao (o
///   contexto do evento). E o gatilho, nao um escopo de compartilhamento.
/// - Dedupe = a nivel de aplicacao (nao ha PENDING duplicado para o mesmo
///   par+especialidade do mesmo paciente); nao ha unique no banco porque o
///   status faz parte da identidade de negocio (um par ACTED pode voltar a ser
///   sugerido no futuro). Datas em UTC (D-067).
model SharingSuggestion {
  id               String           @id @default(cuid())
  patientProfileId String
  professionalAId  String // par normalizado: professionalAId < professionalBId
  professionalBId  String
  specialtyId      String // especialidade do vinculo que disparou a sugestao
  status           SuggestionStatus @default(PENDING)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  patientProfile PatientProfile      @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  professionalA  ProfessionalProfile @relation("SuggestionProfessionalA", fields: [professionalAId], references: [id], onDelete: Cascade)
  professionalB  ProfessionalProfile @relation("SuggestionProfessionalB", fields: [professionalBId], references: [id], onDelete: Cascade)
  specialty      Specialty           @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  @@index([patientProfileId, status])
  @@map("sharing_suggestion")
}
