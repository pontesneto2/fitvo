# Variaveis do docker-compose de desenvolvimento.
# Copie para docker/.env (ignorado pelo git) e ajuste conforme necessario.
# Uso local apenas — nunca versionar valores reais.

POSTGRES_USER=fitvo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fitvo
# 5434 e nao 5432 de proposito: a 5432 costuma estar ocupada por um Postgres
# NATIVO na maquina, e o repo acabaria apontando para o banco errado sem avisar.
# Ver docs/troubleshooting.md.
POSTGRES_PORT=5434

REDIS_PORT=6379
